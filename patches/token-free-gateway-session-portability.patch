@@ -57,19 +57,49 @@ class BrowserManager {
 	 * Get or create a page for the given domain.
 	 * Reuses an existing tab whose URL contains the domain string.
 	 */
-	async getPage(domain: string, fallbackUrl?: string): Promise<Page> {
+	async getPage(domain: string, fallbackUrl?: string, userAgent?: string): Promise<Page> {
 		const ctx = await this.getContext();
 		const pages = ctx.pages();
 		const existing = pages.find((p) => p.url().includes(domain));
-		if (existing) return existing;
+		if (existing) {
+			if (await this.applyUserAgent(existing, userAgent)) {
+				await existing.goto(fallbackUrl || existing.url(), {
+					waitUntil: "domcontentloaded",
+				}).catch(() => {});
+			}
+			return existing;
+		}
 
 		const page = await ctx.newPage();
+		await this.applyUserAgent(page, userAgent);
 		if (fallbackUrl) {
 			await page.goto(fallbackUrl, { waitUntil: "domcontentloaded" }).catch(() => {});
 		}
 		return page;
 	}
 
+	/**
+	 * Reuse the browser identity captured during webauth. This matters when
+	 * credentials created on a desktop are imported into a headless server:
+	 * providers can reject the same cookie when it suddenly comes from a
+	 * different browser User-Agent.
+	 */
+	private async applyUserAgent(page: Page, userAgent?: string): Promise<boolean> {
+		const value = userAgent?.trim();
+		if (!value) return false;
+		try {
+			const session = await page.context().newCDPSession(page);
+			await session.send("Emulation.setUserAgentOverride", { userAgent: value });
+			await session.detach();
+			return true;
+		} catch (err) {
+			console.warn(
+				`[BrowserManager] User-Agent override failed: ${err instanceof Error ? err.message : String(err)}`,
+			);
+			return false;
+		}
+	}
+
 	/**
 	 * Inject cookies into the shared browser context.
 	 */
