<%- include('partials/app-start') %>
  <link rel="stylesheet" href="/css/materia-chat.css?v=20260825cardVazio1" />

  <main class="mia-chat" data-recolher-menu>
    <div id="chat-drawer-backdrop" class="mia-chat-drawer-backdrop" hidden aria-hidden="true"></div>

    <div id="mia-manual" class="mia-chat-shell mia-panel">
      <!-- Sidebar de conversas (drawer no mobile) -->
      <aside id="chat-sidebar" class="mia-chat-sidebar">
        <div class="mia-chat-sidebar-head">
          <p class="mia-chat-sidebar-head-title">Conversas</p>
          <button type="button" id="chat-drawer-close" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Fechar conversas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <button type="button" id="chat-nova" class="mia-chat-new">
          <svg class="mia-chat-new-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Nova matéria
        </button>
        <label class="mia-chat-search">
          <span class="sr-only">Buscar conversa</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
          <input id="chat-busca" type="search" placeholder="Buscar conversas…" autocomplete="off" />
        </label>
        <p class="mia-chat-sidebar-label mia-chat-desktop-only">Conversas</p>
        <div id="chat-lista" class="mia-chat-list">
          <p class="mia-chat-list-empty">Carregando…</p>
        </div>
        <div class="mia-chat-sidebar-foot">
          <a href="/minhas-materias" class="mia-chat-foot-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Matérias salvas
          </a>
          <a href="/conteudo" class="mia-chat-foot-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v18M3 12h18"/></svg>
            Criar conteúdo
          </a>
        </div>
      </aside>

      <!-- Thread + composer -->
      <section class="mia-chat-main">
        <header class="mia-chat-header">
          <button type="button" id="chat-drawer-open" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Abrir conversas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h10"/>
            </svg>
          </button>
          <div class="mia-chat-header-title">
            <span>Matéria manual</span>
            <p id="chat-titulo" class="truncate">Nova conversa</p>
          </div>
          <div class="mia-chat-header-actions">
            <button type="button" id="chat-nova-top" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Nova matéria">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
            <button type="button" id="chat-ensinar" class="mia-chat-icon-btn mia-chat-icon-btn--rotulo" title="Ensinar a IA (regras fixas para as próximas matérias)" aria-label="Ensinar a IA">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/></svg>
              <span class="mia-chat-btn-rotulo">Ensinar IA</span>
            </button>
            <button type="button" id="chat-renomear" class="mia-chat-icon-btn hidden" title="Renomear conversa" aria-label="Renomear conversa">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
            </button>
          </div>
        </header>

        <div id="chat-mensagens" class="mia-chat-messages">
          <div id="chat-vazio" class="mia-chat-empty">
            <div class="mia-chat-empty-copy">
              <span class="mia-chat-empty-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 1.7 4.3L18 9l-4.3 1.7L12 15l-1.7-4.3L6 9l4.3-1.7Z"/><path d="m18.5 15 .9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9Z"/></svg>
              </span>
              <h1 class="mia-chat-empty-title">Como posso ajudar?</h1>
              <p class="mia-chat-empty-sub">Crie uma matéria, transforme um link em notícia ou encontre pautas recentes.</p>
            </div>
          </div>
        </div>

        <div class="mia-chat-composer-wrap">
          <div class="mia-chat-composer" id="chat-composer">
            <textarea id="chat-input" rows="1"
              placeholder="Descreva o assunto ou cole vários links, um por linha…"
              class="mia-chat-input"></textarea>
            <span id="chat-links-detectados" class="mia-chat-links-hint hidden"></span>

            <div class="mia-chat-toolbar">
              <div class="mia-chat-toolbar-main">
                <details class="mia-chat-more" id="chat-ferramentas">
                  <summary title="Ferramentas" aria-label="Abrir ferramentas">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <div class="mia-chat-more-menu">
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Pautas</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" class="chat-exemplo mia-chat-menu-item" data-modo-exemplo="pautas" title="Pesquise pautas sobre polêmicas gospel desta semana">
                          <span class="mia-chat-menu-item-title">Pautas</span>
                          <span class="mia-chat-prompt-text">Pesquise pautas sobre polêmicas gospel desta semana</span>
                        </button>
                      </div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Exemplos</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Faça uma matéria sobre católicos e evangélicos juntos na política em 2026">
                          <span class="mia-chat-menu-item-title">Escrever</span>
                          <span class="mia-chat-prompt-text">Faça uma matéria sobre católicos e evangélicos juntos na política em 2026</span>
                        </button>
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Faça uma matéria sobre o crescimento das igrejas">
                          <span class="mia-chat-menu-item-title">Escrever</span>
                          <span class="mia-chat-prompt-text">Faça uma matéria sobre o crescimento das igrejas</span>
                        </button>
                      </div>
                    </section>

                    <!-- Anexos e atalhos de pauta entram por materia-chat-extras.js.
                         A seção some sozinha quando o script não preenche nada. -->
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Anexar ao pedido</p>
                      <div class="mia-chat-menu-grid" id="chat-menu-anexos"></div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Descobrir pautas</p>
                      <div class="mia-chat-menu-grid" id="chat-menu-descobrir"></div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Ajustes</p>
                      <div class="mia-chat-tools">
                        <button type="button" id="chat-toggle-transcricao" aria-pressed="true"
                          title="Primeiro usa a transcrição disponibilizada pela plataforma. Se não houver, processa somente o áudio."
                          class="mia-chat-chip is-on">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 7v10"/><path d="M20 10v4"/>
                          </svg>
                          Áudio se não houver transcrição
                        </button>

                        <label class="mia-chat-tool-field">
                          <span>Período da busca</span>
                          <select id="chat-periodo" title="Período da busca" class="mia-chat-select">
                            <option value="24h">24h</option>
                            <option value="3d">3 dias</option>
                            <option value="7d">7 dias</option>
                            <option value="15d">15 dias</option>
                            <option value="30d" selected>30 dias</option>
                            <option value="60d">60 dias</option>
                            <option value="90d">90 dias</option>
                            <option value="180d">180 dias</option>
                          </select>
                        </label>

                        <label class="mia-chat-tool-field">
                          <span>Tom da escrita</span>
                          <select id="chat-tom" title="Tom da escrita" class="mia-chat-select">
                            <option value="natural" selected>Natural</option>
                            <option value="polemico">Polêmico</option>
                            <option value="direto">Direto</option>
                            <option value="curiosidade">Curiosidade</option>
                            <option value="emocional">Emocional</option>
                            <option value="factual">Factual</option>
                          </select>
                        </label>
                      </div>
                    </section>
                  </div>
                </details>

                <div class="mia-chat-seg" id="chat-tipo-seg" role="group" aria-label="Tipo de conversa">
                  <button type="button" data-chat-tipo="materia" aria-pressed="true"
                    title="Cria matérias usando as regras editoriais do sistema"
                    class="chat-tipo-btn mia-chat-seg-btn is-active">Matéria</button>
                  <button type="button" data-chat-tipo="livre" aria-pressed="false"
                    title="Conversa normal com o Claude, sem critérios editoriais"
                    class="chat-tipo-btn mia-chat-seg-btn">Claude livre</button>
                </div>
                <div class="mia-chat-seg" id="chat-modo-seg" role="group" aria-label="O que a IA deve fazer">
                  <button type="button" data-chat-modo="escrever" aria-pressed="true"
                    title="A IA já escreve a matéria com o que você pedir"
                    class="chat-modo-btn mia-chat-seg-btn is-active">Escrever</button>
                  <button type="button" data-chat-modo="pautas" aria-pressed="false"
                    title="A IA pesquisa o tema e lista as matérias publicadas para você escolher"
                    class="chat-modo-btn mia-chat-seg-btn">Pautas</button>
                </div>
                <button type="button" id="chat-toggle-web" aria-pressed="false"
                  title="Desligado: extrai o link e escreve sem verificar. Ligado: pesquisa outras fontes, verifica os fatos e revisa."
                  class="mia-chat-chip mia-chat-web-toggle">
                  <span class="mia-chat-chip-dot"></span>
                  <span id="chat-toggle-web-label">Pesquisar na web</span>
                </button>
              </div>

              <span id="chat-status" class="mia-chat-status" aria-live="polite"></span>

              <div class="mia-chat-send-row">
                <button type="button" id="chat-parar" class="mia-chat-stop hidden">Parar</button>
                <details class="mia-chat-more mia-chat-more--criar" id="chat-criar">
                  <summary title="Criar" aria-label="Criar matéria">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <div class="mia-chat-more-menu">
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Criar</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" id="chat-criar-manual" class="mia-chat-menu-item" title="Escrever minha própria matéria e abrir no editor">
                          <span class="mia-chat-menu-item-title">Manual</span>
                          <span class="mia-chat-prompt-text">Escrever minha própria matéria e abrir no editor</span>
                        </button>
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Faça uma matéria deste link">
                          <span class="mia-chat-menu-item-title">Link</span>
                          <span class="mia-chat-prompt-text">Faça uma matéria deste link</span>
                        </button>
                        <button type="button" id="chat-varios-links" class="chat-varios-links mia-chat-menu-item" title="Cole até 12 links, um por linha">
                          <span class="mia-chat-menu-item-title">Vários links</span>
                          <span class="mia-chat-prompt-text">Criar uma matéria por link</span>
                        </button>
                      </div>
                    </section>
                  </div>
                </details>
                <button type="button" id="chat-voz" class="mia-chat-voice" title="Gravar áudio para escrever" aria-label="Gravar áudio para escrever" aria-pressed="false">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <path d="M12 19v3"/>
                    <path d="M8 22h8"/>
                  </svg>
                </button>
                <button type="button" id="chat-enviar" class="mia-chat-send" title="Enviar (Enter)" aria-label="Enviar">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M3.4 20.4l17.45-7.48a1 1 0 000-1.84L3.4 3.6a.993.993 0 00-1.39.91L2 9.12c0 .5.37.93.87.99L17 12 2.87 13.88c-.5.07-.87.5-.87.99l.01 4.61c0 .81.88 1.32 1.39.91z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <p class="mia-chat-hint">Enter envia · Shift+Enter quebra linha</p>
        </div>

        <div id="chat-ensinar-backdrop" class="mia-manual-backdrop hidden" hidden></div>
        <form id="chat-ensinar-form" class="mia-manual-draft hidden" aria-modal="true" role="dialog" aria-labelledby="chat-ensinar-titulo-label">
          <div class="mia-manual-draft-head">
            <p id="chat-ensinar-titulo-label">Ensinar a IA</p>
            <button type="button" id="chat-ensinar-fechar" aria-label="Fechar">×</button>
          </div>
          <p class="mia-ensinar-ajuda">
            Uma orientação por linha. A IA passa a seguir isso em <strong>todas</strong> as próximas
            matérias — aqui no chat e no agendamento da biblioteca.<br>
            Se duas regras se contradisserem, <strong>a última linha vence</strong>.
          </p>
          <textarea id="chat-ensinar-texto" rows="8"
            placeholder="Ex.: Crédito da fonte só no fim do texto&#10;Nunca começar o título com pergunta&#10;Sempre traduzir material em inglês"></textarea>
          <button type="submit">Salvar orientações</button>
          <p id="chat-ensinar-status"></p>
        </form>

        <div id="chat-manual-backdrop" class="mia-manual-backdrop hidden" hidden></div>
        <form id="chat-manual-form" class="mia-manual-draft hidden" aria-modal="true" role="dialog" aria-labelledby="chat-manual-titulo-label">
          <div class="mia-manual-draft-head">
            <p id="chat-manual-titulo-label">Criar materia manual</p>
            <button type="button" id="chat-manual-fechar" aria-label="Fechar">×</button>
          </div>
          <input id="chat-manual-titulo" type="text" maxlength="180" placeholder="Titulo da materia" />
          <textarea id="chat-manual-texto" rows="8" placeholder="Escreva ou cole aqui o texto da materia..."></textarea>
          <div class="mia-manual-draft-row">
            <input id="chat-manual-tags" type="text" maxlength="180" placeholder="Hashtags opcionais: gospel, politica..." />
            <select id="chat-manual-tipo" title="Tipo de publicacao">
              <option value="foto" selected>Foto + arte</option>
              <option value="texto">Texto</option>
            </select>
          </div>
          <textarea id="chat-manual-credito" rows="2" placeholder="Credito/fonte opcional"></textarea>
          <button type="submit">Criar rascunho e editar</button>
          <p id="chat-manual-status"></p>
        </form>
      </section>
    </div>
  </main>

  <script>
    (function () {
      const openBtn = document.getElementById('chat-criar-manual');
      const form = document.getElementById('chat-manual-form');
      const backdrop = document.getElementById('chat-manual-backdrop');
      const closeBtn = document.getElementById('chat-manual-fechar');
      const statusEl = document.getElementById('chat-manual-status');
      const tituloEl = document.getElementById('chat-manual-titulo');
      const textoEl = document.getElementById('chat-manual-texto');
      const tagsEl = document.getElementById('chat-manual-tags');
      const tipoEl = document.getElementById('chat-manual-tipo');
      const creditoEl = document.getElementById('chat-manual-credito');
      const chatMain = document.querySelector('.mia-chat-main');
      function fecharMenusMais() {
        document.querySelectorAll('.mia-chat-more').forEach((menu) => {
          menu.open = false;
        });
      }
      function setManualStatus(text, erro) {
        if (!statusEl) return;
        statusEl.textContent = text || '';
        statusEl.style.color = erro ? '#fda4af' : '#94a3b8';
      }
      function setManualOpen(open) {
        form?.classList.toggle('hidden', !open);
        backdrop?.classList.toggle('hidden', !open);
        if (backdrop) backdrop.hidden = !open;
        chatMain?.classList.toggle('is-manual-open', open);
        if (!open) setManualStatus('');
      }
      openBtn?.addEventListener('click', () => {
        fecharMenusMais();
        setManualOpen(true);
        tituloEl?.focus();
      });
      closeBtn?.addEventListener('click', () => setManualOpen(false));
      backdrop?.addEventListener('click', () => setManualOpen(false));
      document.querySelectorAll('.mia-chat-more').forEach((menu) => {
        menu.addEventListener('toggle', () => {
          if (!menu.open) return;
          document.querySelectorAll('.mia-chat-more').forEach((outro) => {
            if (outro !== menu) outro.open = false;
          });
        });
      });
      document.addEventListener('pointerdown', (e) => {
        document.querySelectorAll('.mia-chat-more[open]').forEach((menu) => {
          if (!menu.contains(e.target)) menu.removeAttribute('open');
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') fecharMenusMais();
        if (e.key === 'Escape' && form && !form.classList.contains('hidden')) {
          setManualOpen(false);
        }
        if (e.key === 'Escape' && ensinarForm && !ensinarForm.classList.contains('hidden')) {
          setEnsinarOpen(false);
        }
      });
      // "Ensinar a IA": grava regras fixas que valem para as próximas matérias.
      const ensinarBtn = document.getElementById('chat-ensinar');
      const ensinarForm = document.getElementById('chat-ensinar-form');
      const ensinarBackdrop = document.getElementById('chat-ensinar-backdrop');
      const ensinarFechar = document.getElementById('chat-ensinar-fechar');
      const ensinarTexto = document.getElementById('chat-ensinar-texto');
      const ensinarStatus = document.getElementById('chat-ensinar-status');
      const QUEBRA = String.fromCharCode(10);
      let ensinarCarregado = false;

      function setEnsinarStatus(text, erro) {
        if (!ensinarStatus) return;
        ensinarStatus.textContent = text || '';
        ensinarStatus.style.color = erro ? '#fda4af' : '#94a3b8';
      }
      function linhasDeOrientacoes(texto) {
        return String(texto || '')
          .split(/\r?\n/)
          .map((l) => l.replace(/^[ \t]*[-•*][ \t]*/, '').trim())
          .filter(Boolean);
      }
      function setEnsinarOpen(open) {
        ensinarForm?.classList.toggle('hidden', !open);
        ensinarBackdrop?.classList.toggle('hidden', !open);
        if (ensinarBackdrop) ensinarBackdrop.hidden = !open;
        chatMain?.classList.toggle('is-manual-open', open);
        if (!open) setEnsinarStatus('');
      }
      ensinarBtn?.addEventListener('click', async () => {
        setEnsinarOpen(true);
        ensinarTexto?.focus();
        if (ensinarCarregado) return;
        setEnsinarStatus('Carregando o que a IA já aprendeu…');
        try {
          const res = await fetch('/api/materias-ia/chat/orientacoes', {
            headers: { Accept: 'application/json' },
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Não foi possível carregar as orientações.');
          const linhas = linhasDeOrientacoes(data.orientacoes);
          if (ensinarTexto) ensinarTexto.value = linhas.join(QUEBRA);
          ensinarCarregado = true;
          setEnsinarStatus(
            linhas.length ? linhas.length + ' orientação(ões) em uso.' : 'Nenhuma orientação ainda.'
          );
        } catch (err) {
          setEnsinarStatus(err.message, true);
        }
      });
      ensinarFechar?.addEventListener('click', () => setEnsinarOpen(false));
      ensinarBackdrop?.addEventListener('click', () => setEnsinarOpen(false));
      ensinarForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = ensinarForm.querySelector('button[type="submit"]');
        const original = btn?.textContent;
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Salvando…';
        }
        setEnsinarStatus('Gravando na memória da IA…');
        try {
          const res = await fetch('/api/materias-ia/chat/orientacoes', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ orientacoes: String(ensinarTexto?.value || '') }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Não foi possível salvar.');
          const linhas = linhasDeOrientacoes(data.orientacoes);
          if (ensinarTexto) ensinarTexto.value = linhas.join(QUEBRA);
          setEnsinarStatus(
            linhas.length
              ? 'Guardado ✓ a IA vai seguir isso nas próximas matérias.'
              : 'Orientações apagadas.'
          );
        } catch (err) {
          setEnsinarStatus(err.message, true);
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.textContent = original || 'Salvar orientações';
          }
        }
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const titulo = String(tituloEl?.value || '').trim();
        const materia = String(textoEl?.value || '').trim();
        if (titulo.length < 3) {
          setManualStatus('Escreva um titulo.', true);
          tituloEl?.focus();
          return;
        }
        if (materia.length < 40) {
          setManualStatus('Escreva o texto da materia.', true);
          textoEl?.focus();
          return;
        }
        const btn = form.querySelector('button[type="submit"]');
        const original = btn?.textContent;
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Criando...';
        }
        setManualStatus('Salvando rascunho manual...');
        try {
          const res = await fetch('/api/materias-ia/manual', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              titulo,
              materia,
              hashtags: String(tagsEl?.value || '').trim(),
              fonteCredito: String(creditoEl?.value || '').trim(),
              tipoPublicacao: tipoEl?.value || 'foto',
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Nao foi possivel criar a materia manual.');
          location.href = data.redirect || (data.matter?.id ? '/materias-ia/' + data.matter.id : '/minhas-materias');
        } catch (err) {
          setManualStatus(err.message, true);
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.textContent = original || 'Criar rascunho e editar';
          }
        }
      });
    })();
  </script>
