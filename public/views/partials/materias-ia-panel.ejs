<section id="painel-materias-ia" class="<%= typeof miaStandalone !== 'undefined' && miaStandalone ? '' : 'mt-6 hidden' %>">
  <% if (!(typeof miaStandalone !== 'undefined' && miaStandalone)) { %>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-xl font-semibold text-white">Gerar matérias com IA</h2>
      <p class="mt-1 text-sm text-slate-400">1) Busque pautas · 2) Gere a matéria · 3) Revise e publique na Página.</p>
    </div>
  </div>
  <% } %>

  <div class="mt-4 flex max-w-full gap-1 overflow-x-auto rounded-xl border border-slate-700 bg-slate-900 p-1 sm:inline-flex sm:flex-wrap sm:overflow-visible" role="tablist" aria-label="Modos matérias IA">
    <button type="button" data-mia-modo="buscar" class="mia-modo-btn shrink-0 rounded-lg bg-emerald-500 px-3 py-1.5 text-xs font-semibold text-slate-950 sm:px-4 sm:py-2 sm:text-sm">Buscar e escolher</button>
    <button type="button" data-mia-modo="alta" class="mia-modo-btn shrink-0 rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white sm:px-4 sm:py-2 sm:text-sm">Em alta agora</button>
    <button type="button" data-mia-modo="radar" class="mia-modo-btn shrink-0 rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white sm:px-4 sm:py-2 sm:text-sm">Radar Face</button>
    <button type="button" data-mia-modo="link" class="mia-modo-btn shrink-0 rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white sm:px-4 sm:py-2 sm:text-sm">A partir do link</button>
    <button type="button" data-mia-modo="auto" class="mia-modo-btn shrink-0 rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white sm:px-4 sm:py-2 sm:text-sm">Automação</button>
    <button type="button" data-mia-modo="manual" class="mia-modo-btn shrink-0 rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white sm:px-4 sm:py-2 sm:text-sm">Matéria manual</button>
  </div>

  <div id="mia-buscar" class="mia-panel mt-5 space-y-5">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-400/80">Passo 1 — Busca</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="mia-tag rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300 hover:border-emerald-500" data-tag="gospel">gospel</button>
        <button type="button" class="mia-tag rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300 hover:border-emerald-500" data-tag="pastor">pastor</button>
        <button type="button" class="mia-tag rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300 hover:border-emerald-500" data-tag="louvor">louvor</button>
        <button type="button" class="mia-tag rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300 hover:border-emerald-500" data-tag="fé">fé</button>
        <button type="button" class="mia-tag rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-300 hover:border-emerald-500" data-tag="brasil">brasil</button>
      </div>

      <div class="mt-4 grid gap-3 lg:grid-cols-2">
        <label class="block text-sm">
          <span class="text-slate-400">Palavras-chave</span>
          <input id="mia-keywords" type="text" placeholder="ex.: gospel, pastor, louvor"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Onde buscar</span>
          <select id="mia-onde" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100">
            <option value="tudo">Notícias + portais + redes</option>
            <option value="noticias">Somente notícias</option>
            <option value="redes">Somente redes</option>
          </select>
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Qtd. por nicho</span>
          <input id="mia-qtd" type="number" min="1" max="20" value="8"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Período</span>
          <select id="mia-periodo" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100">
            <option value="24h">Últimas 24h</option>
            <option value="3d">3 dias</option>
            <option value="7d">7 dias</option>
            <option value="30d">30 dias (1 mês)</option>
            <option value="90d">90 dias (3 meses)</option>
            <option value="180d" selected>180 dias (6 meses)</option>
          </select>
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Tipo de publicação</span>
          <select id="mia-tipo" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100">
            <option value="foto" selected>Foto + legenda</option>
            <option value="texto">Texto</option>
          </select>
        </label>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" id="mia-btn-buscar" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">Buscar assuntos</button>
        <button type="button" id="mia-btn-preview" class="rounded-lg border border-violet-500/50 bg-violet-500/15 px-4 py-2 text-sm text-violet-200 hover:bg-violet-500/25">Gerar matéria do selecionado</button>
        <button type="button" id="mia-btn-lote" class="rounded-lg border border-sky-500/50 bg-sky-500/10 px-4 py-2 text-sm text-sky-200 hover:bg-sky-500/20">Gerar selecionados (lote)</button>
      </div>
      <p id="mia-status" class="mt-3 text-sm text-slate-400"></p>
    </div>

    <!-- Preview inline removido: após gerar, o usuário vai para /materias-ia/:id -->

    <div>
      <div class="mb-2 flex items-center justify-between gap-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Passo 2 — Assuntos encontrados</p>
        <p id="mia-topicos-count" class="text-xs text-slate-500"></p>
      </div>
      <div id="mia-topicos" class="space-y-2"></div>
    </div>
  </div>

  <div id="mia-alta" class="mia-panel mt-5 hidden space-y-4">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <label class="block text-sm">
        <span class="text-slate-400">Termos extras (opcional)</span>
        <input id="mia-alta-extras" type="text" placeholder="ex.: assembléia de deus, cantor gospel"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
      </label>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" id="mia-btn-alta" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950">Radar em alta</button>
        <button type="button" id="mia-btn-preview-alta" class="rounded-lg border border-violet-500/50 bg-violet-500/15 px-4 py-2 text-sm text-violet-200">Gerar matéria do selecionado</button>
      </div>
      <p id="mia-alta-status" class="mt-3 text-sm text-slate-400"></p>
    </div>
    <div id="mia-alta-topicos" class="space-y-2"></div>
  </div>

  <div id="mia-radar" class="mia-panel mt-5 hidden space-y-4">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-400/80">Radar Face — Trends + engajamento</p>
      <p class="mt-2 text-sm text-slate-400">
        Cruza Google Trends (Brasil, filtro gospel) com posts públicos do Facebook.
        Cole um <strong class="font-medium text-slate-300">link de post</strong> ou da
        <strong class="font-medium text-slate-300">página</strong>: a IA lê o tema e busca o que está em alta no mesmo assunto.
      </p>
      <p class="mt-2 text-[11px] leading-relaxed text-slate-500">
        Busca <strong class="font-medium text-slate-400">posts recentes (até ~7 dias)</strong> com viés Brasil + gospel.
        Aceita <strong class="font-medium text-slate-400">#hashtags</strong> e links de post/página do Facebook.
        <strong class="font-medium text-slate-400">Página:</strong> prioriza ScrapeCreators (pay-as-you-go, curtidas reais);
        Apify free tier = ~1 busca/24h — use o cache e evite “Forçar”.
      </p>

      <label class="mt-4 block text-sm">
        <span class="text-slate-400">Link do post ou da página (opcional)</span>
        <input id="mia-radar-url" type="url" inputmode="url"
          placeholder="https://www.facebook.com/posts/… ou https://www.facebook.com/NomeDaPagina"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
      </label>
      <div class="mt-2 flex flex-wrap items-end gap-2">
        <label class="min-w-[10rem] flex-1 text-sm">
          <span class="text-slate-500">Nome na lista (opcional)</span>
          <input id="mia-radar-link-nome" type="text" placeholder="ex.: Página Malafaia"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-sm text-slate-100" />
        </label>
        <button type="button" id="mia-btn-radar-salvar-link"
          class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs font-medium text-emerald-200 hover:border-emerald-400">
          Salvar link na lista
        </button>
      </div>
      <div class="mt-3 rounded-xl border border-slate-800 bg-slate-950/40 p-3">
        <div class="flex items-center justify-between gap-2">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Links salvos</p>
          <button type="button" class="mia-btn-refresh-links text-[11px] text-slate-500 hover:text-slate-300">Atualizar</button>
        </div>
        <div id="mia-radar-links-list" class="mia-links-list mt-2 max-h-48 space-y-1 overflow-y-auto" data-target="mia-radar-url"></div>
      </div>
      <p class="mt-1 text-[11px] text-slate-500">
        Post → analisa a legenda e procura sinais em alta no tema.
        Página → lista os posts <strong class="font-medium text-slate-400">dessa página</strong> e destaca os que mais engajam.
      </p>

      <label class="mt-3 block text-sm">
        <span class="text-slate-400">Termos ou hashtags (opcional)</span>
        <input id="mia-radar-extras" type="text" placeholder="ex.: #gospel, #igreja, malafaia — complementa o link"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
      </label>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="button" id="mia-btn-radar" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">Analisar agora</button>
        <button type="button" id="mia-btn-radar-force" class="rounded-lg border border-slate-600 px-3 py-2 text-xs text-slate-300 hover:border-slate-400" title="Ignora cache e gasta créditos Apify de novo">Forçar nova análise</button>
        <button type="button" id="mia-btn-preview-radar" class="rounded-lg border border-violet-500/50 bg-violet-500/15 px-4 py-2 text-sm text-violet-200">Gerar matéria do selecionado</button>
      </div>
      <p id="mia-radar-status" class="mt-3 text-sm text-slate-400"></p>
    </div>
    <div id="mia-radar-topicos" class="space-y-2"></div>
  </div>

  <div id="mia-link" class="mia-panel mt-5 hidden space-y-4">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-400/80">Reescrever a partir do link</p>
      <p class="mt-2 text-sm text-slate-400">
        Cole o link de uma <strong class="font-medium text-slate-300">foto do Facebook</strong>,
        <strong class="font-medium text-slate-300">notícia</strong> ou
        <strong class="font-medium text-slate-300">Reel</strong>.
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-xs text-slate-500">
        <li><strong class="font-medium text-slate-400">Post de foto FB/IG</strong> → extrai a legenda e a imagem, a IA reescreve a matéria; na edição você pode manter a foto do post ou escolher outra sugerida.</li>
        <li>Notícia → matéria com imagem da fonte (ou sugestões).</li>
        <li>Reel/vídeo → baixa, transcreve, legenda + capa e abre em /materias-ia.</li>
      </ul>

      <label class="mt-4 block text-sm">
        <span class="text-slate-400">Link (foto do Facebook, notícia ou Reel)</span>
        <input id="mia-link-url" type="url" inputmode="url"
          placeholder="https://www.facebook.com/photo/?fbid=… ou /posts/… ou Reel"
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
      </label>
      <div class="mt-2 flex flex-wrap items-end gap-2">
        <label class="min-w-[10rem] flex-1 text-sm">
          <span class="text-slate-500">Nome na lista (opcional)</span>
          <input id="mia-link-save-nome" type="text" placeholder="ex.: Post polêmica X"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-sm text-slate-100" />
        </label>
        <button type="button" id="mia-btn-link-salvar-link"
          class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs font-medium text-emerald-200 hover:border-emerald-400">
          Salvar link na lista
        </button>
      </div>
      <div class="mt-3 rounded-xl border border-slate-800 bg-slate-950/40 p-3">
        <div class="flex items-center justify-between gap-2">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Links salvos</p>
          <button type="button" class="mia-btn-refresh-links text-[11px] text-slate-500 hover:text-slate-300">Atualizar</button>
        </div>
        <div id="mia-link-links-list" class="mia-links-list mt-2 max-h-48 space-y-1 overflow-y-auto" data-target="mia-link-url"></div>
      </div>

      <details class="mt-3 rounded-xl border border-amber-500/25 bg-amber-500/5">
        <summary class="cursor-pointer px-3 py-2.5 text-xs font-medium text-amber-100 hover:text-white">
          Se o Facebook bloquear a leitura — cole a legenda aqui
        </summary>
        <div class="space-y-3 border-t border-amber-500/20 px-3 py-3">
          <p class="text-[11px] leading-relaxed text-slate-400">
            O Facebook muitas vezes pede login no servidor e a extração falha. Copie o texto do post (como no app) e cole abaixo. A IA usa esse texto — não inventa outro assunto.
          </p>
          <label class="block text-sm">
            <span class="text-slate-400">Texto da postagem (legenda)</span>
            <textarea id="mia-link-texto" rows="4" placeholder="Cole aqui a legenda completa do post…"
              class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none"></textarea>
          </label>
          <label class="block text-sm">
            <span class="text-slate-400">URL da imagem (opcional)</span>
            <input id="mia-link-imagem" type="url" placeholder="https://… (link direto da foto, se tiver)"
              class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none" />
          </label>
        </div>
      </details>

      <div class="mt-3 grid gap-3 lg:grid-cols-2">
        <label class="block text-sm">
          <span class="text-slate-400">Tipo de publicação</span>
          <select id="mia-link-tipo" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100">
            <option value="auto" selected>Automático (detecta Reel)</option>
            <option value="foto">Foto + legenda</option>
            <option value="texto">Texto</option>
            <option value="reel">Reel (vídeo)</option>
          </select>
        </label>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" id="mia-btn-link" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">Gerar a partir do link</button>
        <button type="button" id="mia-btn-link-limpar" class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-300 hover:border-slate-400 hover:text-white">Limpar</button>
      </div>
      <p id="mia-link-status" class="mt-3 text-sm text-slate-400"></p>
    </div>
  </div>

  <div id="mia-auto" class="mia-panel mt-5 hidden space-y-4">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
      <p class="text-sm text-slate-400">Busca novos assuntos e publica automaticamente. Intervalo mínimo: 5 minutos.</p>
      <div class="mt-4 grid gap-3 lg:grid-cols-2">
        <label class="block text-sm">
          <span class="text-slate-400">Palavras-chave</span>
          <input id="mia-auto-kw" type="text" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Intervalo (minutos)</span>
          <input id="mia-auto-intervalo" type="number" min="5" value="30" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Posts por ciclo</span>
          <input id="mia-auto-qtd" type="number" min="1" max="3" value="1" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Tipo</span>
          <select id="mia-auto-tipo" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100">
            <option value="foto" selected>Foto + legenda</option>
            <option value="texto">Texto</option>
          </select>
        </label>
      </div>
      <button type="button" id="mia-btn-auto" class="mt-4 rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950">Criar automação</button>
      <p id="mia-auto-status" class="mt-3 text-sm text-slate-400"></p>
    </div>
    <div id="mia-monitores" class="space-y-2"></div>
  </div>

  <div id="mia-manual" class="mia-panel mt-3 hidden sm:mt-5">
    <div class="grid gap-3 xl:grid-cols-[280px_minmax(0,1fr)] lg:grid-cols-[235px_minmax(0,1fr)]">
      <aside class="flex max-h-32 flex-col rounded-xl border border-slate-800 bg-slate-900/50 p-2 sm:max-h-48 lg:max-h-[calc(100vh-13.5rem)] lg:rounded-2xl lg:p-3">
        <button type="button" id="chat-nova"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-500 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-emerald-400 sm:text-sm lg:rounded-xl">
          <span class="text-base leading-none">+</span> Nova conversa
        </button>
        <input id="chat-busca" type="search" placeholder="Buscar conversa…"
          class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none lg:mt-3" />
        <p class="mt-2 px-1 text-[10px] font-semibold uppercase tracking-wide text-slate-500 lg:mt-4 lg:text-[11px]">Conversas</p>
        <div id="chat-lista" class="mt-1 flex-1 space-y-1 overflow-y-auto pr-1 text-xs sm:text-sm">
          <p class="px-1 py-2 text-xs text-slate-500">Carregando…</p>
        </div>
      </aside>

      <div class="flex h-[62svh] min-h-[350px] flex-col rounded-xl border border-slate-800 bg-slate-900/50 sm:h-[calc(100svh-14rem)] sm:min-h-[480px] lg:h-[calc(100vh-13.5rem)] lg:min-h-[560px] lg:rounded-2xl">
        <header class="flex items-center justify-between gap-2 border-b border-slate-800 px-3 py-2.5 sm:gap-3 sm:px-4 sm:py-3">
          <div class="min-w-0">
            <p id="chat-titulo" class="truncate text-sm font-semibold text-white">Nova conversa</p>
            <p class="hidden text-[11px] text-slate-500 sm:block">A IA pesquisa na web, escreve a matéria e você refina no chat antes de salvar o rascunho.</p>
          </div>
          <button type="button" id="chat-renomear"
            class="hidden shrink-0 rounded-lg border border-slate-700 px-2 py-1 text-xs text-slate-300 hover:border-emerald-500 hover:text-white">Renomear</button>
        </header>

        <div id="chat-mensagens" class="flex-1 space-y-3 overflow-y-auto px-3 py-3 sm:space-y-4 sm:px-4 sm:py-4 lg:space-y-5 lg:py-5">
          <div id="chat-vazio" class="mx-auto max-w-lg py-4 text-center sm:py-8 lg:py-10">
            <p class="text-base font-semibold text-white sm:text-lg">O que vamos noticiar hoje?</p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-400 sm:mt-2 sm:text-sm">
              Peça o assunto e a IA busca na internet, lê as reportagens e escreve a matéria.
              Depois você pede ajustes no próprio chat e só salva quando gostar.
            </p>
            <div class="mt-3 flex flex-wrap justify-center gap-1.5 sm:mt-4 sm:gap-2">
              <button type="button" class="chat-exemplo rounded-full border border-slate-700 px-2.5 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-white sm:px-3 sm:py-1.5 sm:text-xs">
                faça uma matéria sobre católicos e evangélicos juntos na política em 2026
              </button>
              <button type="button" class="chat-exemplo rounded-full border border-slate-700 px-2.5 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-white sm:px-3 sm:py-1.5 sm:text-xs">
                pesquise o que saiu hoje sobre pesquisa eleitoral no Nordeste
              </button>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-800 px-2.5 py-2 sm:px-4 sm:py-3">
          <div class="rounded-xl border border-slate-700 bg-slate-950 p-2 focus-within:border-emerald-500 sm:rounded-2xl">
            <textarea id="chat-input" rows="2"
              placeholder="Peça a matéria, tire uma dúvida ou peça um ajuste (Enter envia, Shift+Enter pula linha)"
              class="max-h-28 min-h-[2.5rem] w-full resize-none bg-transparent px-2 py-1 text-sm text-slate-100 placeholder:text-slate-600 focus:outline-none sm:max-h-36"></textarea>
            <div class="mt-1 grid gap-1.5 px-1 sm:flex sm:flex-wrap sm:items-center sm:gap-2">
              <button type="button" id="chat-toggle-web" aria-pressed="true"
                class="inline-flex items-center justify-center gap-1.5 rounded-full border border-emerald-500/60 bg-emerald-500/15 px-3 py-1 text-xs font-medium text-emerald-200 sm:justify-start">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Pesquisar na web
              </button>
              <select id="chat-tom" title="Tom editorial"
                class="min-w-0 rounded-full border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-300 focus:border-emerald-500 focus:outline-none">
                <option value="natural" selected>Tom: natural</option>
                <option value="polemico">Tom: polêmico</option>
                <option value="direto">Tom: direto</option>
                <option value="curiosidade">Tom: curiosidade</option>
                <option value="emocional">Tom: emocional</option>
                <option value="factual">Tom: factual</option>
              </select>
              <select id="chat-periodo" title="Só busca notícias publicadas nesse período"
                class="min-w-0 rounded-full border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-300 focus:border-emerald-500 focus:outline-none">
                <option value="24h">Hoje (24h)</option>
                <option value="3d">Últimos 3 dias</option>
                <option value="7d" selected>Últimos 7 dias</option>
                <option value="15d">Últimos 15 dias</option>
                <option value="30d">Últimos 30 dias</option>
                <option value="60d">Últimos 60 dias</option>
                <option value="90d">Últimos 90 dias</option>
                <option value="180d">Últimos 180 dias</option>
              </select>
              <span id="chat-status" class="min-h-[1rem] text-xs text-slate-500 sm:min-h-0"></span>
              <div class="flex items-center gap-2 sm:ml-auto">
                <button type="button" id="chat-parar"
                  class="hidden flex-1 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:border-rose-500 hover:text-rose-200 sm:flex-none">Parar</button>
                <button type="button" id="chat-enviar"
                  class="flex-1 rounded-lg bg-emerald-500 px-4 py-1.5 text-sm font-semibold text-slate-950 hover:bg-emerald-400 sm:flex-none">Enviar</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
