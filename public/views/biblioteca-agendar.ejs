<%- include('partials/app-start') %>
<%
  const lista = typeof itens !== 'undefined' && Array.isArray(itens) ? itens : [];
  const viralList = typeof viralizadas !== 'undefined' && Array.isArray(viralizadas) ? viralizadas : [];
  const abaAtual =
    typeof aba !== 'undefined' && (aba === 'publicadas' || aba === 'viralizadas')
      ? aba
      : 'agendada';
  const counts = typeof contagens === 'object' && contagens
    ? contagens
    : { agendada: 0, publicadas: 0, viralizadas: 0 };
  const pagesList = typeof pages !== 'undefined' && Array.isArray(pages) ? pages : [];
  const defPageId = typeof defaultPageId !== 'undefined' ? Number(defaultPageId) : null;
  const statusLabels = {
    pendente: 'Pré-agendado',
    confirmado: 'Agendada',
    agendada: 'Agendada',
    publicado: 'Publicado',
    cancelado: 'Cancelado',
  };
  const statusClass = {
    pendente: 'bg-amber-500/15 text-amber-300',
    confirmado: 'bg-amber-500/15 text-amber-300',
    agendada: 'bg-amber-500/15 text-amber-300',
    publicado: 'bg-emerald-500/15 text-emerald-300',
    cancelado: 'bg-slate-800 text-slate-500',
  };
  function fmtQuando(v) {
    if (!v) return '—';
    try {
      const d = new Date(v);
      if (Number.isNaN(d.getTime())) return String(v);
      return d.toLocaleString('pt-BR', { timeZone: 'America/Araguaina', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch {
      return String(v);
    }
  }
  function fmtNum(n) {
    if (n == null || n === '') return '—';
    const v = Number(n);
    if (!Number.isFinite(v)) return '—';
    if (v >= 1000) return (v / 1000).toFixed(1).replace(/\.0$/, '') + ' mil';
    return String(Math.round(v));
  }

  function chaveDia(item) {
    const local = String(item.proposed_at_local || '');
    if (local.length >= 10) return local.slice(0, 10);
    const d = new Date(item.matter_published_at || item.proposed_at);
    if (Number.isNaN(d.getTime())) return 'sem-data';
    return new Date(d.getTime() - 3 * 3600 * 1000).toISOString().slice(0, 10);
  }
  function horaCurta(item) {
    const local = String(item.proposed_at_local || '');
    if (local.length >= 16) return local.slice(11, 16);
    const d = new Date(item.matter_published_at || item.proposed_at);
    if (Number.isNaN(d.getTime())) return '--:--';
    return new Date(d.getTime() - 3 * 3600 * 1000).toISOString().slice(11, 16);
  }

  const hojeKey = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
  const amanhaKey = new Date(Date.now() - 3 * 3600 * 1000 + 86400000).toISOString().slice(0, 10);
  const defaultProposedLocal = amanhaKey + 'T08:00';

  function rotuloDia(diaKey) {
    if (diaKey === hojeKey) return 'Hoje';
    if (diaKey === amanhaKey) return 'Amanhã';
    try {
      const [y, m, d] = String(diaKey).split('-').map(Number);
      const dt = new Date(Date.UTC(y, m - 1, d, 15, 0, 0));
      return dt.toLocaleDateString('pt-BR', { weekday: 'short', day: '2-digit', month: 'short', timeZone: 'America/Araguaina' });
    } catch {
      return diaKey;
    }
  }

  const grupos = [];
  const idxPorDia = new Map();
  lista.forEach(function (item) {
    const dia = chaveDia(item);
    if (!idxPorDia.has(dia)) {
      idxPorDia.set(dia, grupos.length);
      grupos.push({ dia, itens: [] });
    }
    grupos[idxPorDia.get(dia)].itens.push(item);
  });
%>
  <main class="mx-auto max-w-9xl px-4 py-6 sm:px-6" data-agenda-aba="<%= abaAtual %>">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-amber-400/80">Biblioteca</p>
        <h1 class="mt-1 text-xl font-semibold text-white sm:text-2xl">Agendar</h1>
        <p class="mt-1 text-sm text-slate-400">
          <% if (abaAtual === 'viralizadas') { %>
            Matérias que viralizaram em qualquer Página — reescreve no estilo da sua marca e pré-agenda (sem copiar o post original).
          <% } else { %>
            Matérias geradas dos sites da biblioteca, pré-agendadas de 30 em 30 minutos (7h–22h).
          <% } %>
        </p>
      </div>
      <a href="/biblioteca" class="shrink-0 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 hover:border-slate-500 hover:text-white">← Biblioteca</a>
    </header>

    <% if (abaAtual !== 'viralizadas') { %>
    <details class="mt-3 rounded-lg border border-slate-800 bg-slate-900/40">
      <summary class="cursor-pointer list-none px-3 py-2 text-xs font-medium text-slate-400 hover:text-slate-200 [&::-webkit-details-marker]:hidden">
        Como funciona ▾
      </summary>
      <div class="space-y-2 border-t border-slate-800 px-3 py-2.5 text-xs leading-relaxed text-slate-400">
        <p>
          Você pode <strong class="font-medium text-slate-300">alterar data e horário</strong> de qualquer item
          (pré-agendado ou confirmado) — só não para o passado. Ao excluir um item, os seguintes sobem
          automaticamente para manter o intervalo de 30 minutos.
        </p>
        <p>
          <strong class="font-semibold text-sky-300">Automático:</strong> com pelo menos uma matéria confirmada, o
          sistema completa sozinho os horários livres (a cada ~20 min, até 5 por vez). Se você tem palavras-chave
          salvas, o automático <strong class="font-medium text-emerald-300">só puxa posts que batem nelas</strong>.
          Confirme as que quiser; exclua as demais.
        </p>
      </div>
    </details>

    <section class="mt-4 rounded-2xl border border-slate-800 bg-slate-900/50 p-4 <%= abaAtual === 'publicadas' ? 'hidden' : '' %>" id="agenda-montar-wrap">
      <%
        const kwList = typeof keywordsList !== 'undefined' && Array.isArray(keywordsList) ? keywordsList : [];
        const kwCount = kwList.length;
      %>
      <form id="agenda-montar-form" class="space-y-3">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-12 lg:items-end">
          <label class="block sm:col-span-2 lg:col-span-5">
            <span class="text-xs font-medium text-slate-400">Página do Facebook</span>
            <select id="agenda-page" required
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500/30">
              <option value="">Selecione uma página</option>
              <% pagesList.forEach(function (p) {
                const sel = Number(defPageId) === Number(p.id);
              %>
                <option value="<%= p.id %>" <%= sel ? 'selected' : '' %>><%= p.page_name %></option>
              <% }) %>
            </select>
          </label>
          <label class="block lg:col-span-2">
            <span class="text-xs font-medium text-slate-400">Máx. novos itens</span>
            <input id="agenda-max" type="number" min="1" max="48" value="20"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500/30" />
          </label>
          <button type="submit" class="rounded-lg bg-amber-500 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-amber-400 lg:col-span-3">
            Montar agenda de amanhã
          </button>
          <button type="button" id="agenda-btn-compactar"
            class="rounded-lg border border-sky-500/50 bg-sky-500/10 px-4 py-2.5 text-sm font-semibold text-sky-200 hover:bg-sky-500/20 lg:col-span-2">
            Reorganizar 30 em 30
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-xl border border-emerald-500/25 bg-emerald-500/5 px-3 py-2">
          <label class="flex cursor-pointer items-center gap-2">
            <input
              type="checkbox"
              id="agenda-usar-keywords"
              class="rounded border-slate-600 bg-slate-950 text-emerald-500 focus:ring-emerald-500/30"
              <%= kwCount ? 'checked' : 'disabled' %>
            />
            <span class="text-[13px] font-medium text-emerald-100">Só posts com minhas palavras-chave</span>
          </label>
          <% if (kwCount) { %>
            <details class="w-full sm:w-auto">
              <summary class="cursor-pointer text-[11px] text-emerald-300/90 underline-offset-2 hover:underline">Ver palavras (<%= kwCount %>)</summary>
              <div class="mt-1.5 flex flex-wrap gap-1">
                <% kwList.forEach(function (kw) { %>
                  <span class="rounded-md bg-slate-800/80 px-1.5 py-0.5 text-[10px] text-slate-300"><%= kw %></span>
                <% }) %>
              </div>
            </details>
          <% } else { %>
            <a href="/biblioteca" class="text-[11px] text-amber-300/90 underline-offset-2 hover:underline">Nenhuma cadastrada — adicione em Biblioteca</a>
          <% } %>
        </div>

        <p id="agenda-msg" class="hidden text-sm"></p>
      </form>
    </section>
    <% } else { %>
      <p id="agenda-msg" class="mt-3 hidden text-sm"></p>
    <% } %>

    <section class="mt-5">
      <div class="sticky top-14 z-20 -mx-4 border-y border-slate-800 bg-slate-950/95 px-4 py-2.5 backdrop-blur md:top-0 sm:-mx-6 sm:px-6">
        <div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-3">
            <div class="inline-flex flex-wrap rounded-lg border border-slate-700 bg-slate-950 p-0.5" role="tablist" aria-label="Filtrar agenda">
              <a href="/biblioteca/agendar?aba=agendada"
                class="rounded-md px-3.5 py-1.5 text-sm <%= abaAtual === 'agendada' ? 'bg-amber-500 font-semibold text-slate-950' : 'text-slate-300 hover:text-white' %>"
                role="tab" aria-selected="<%= abaAtual === 'agendada' ? 'true' : 'false' %>">
                Agendada
                <span class="ml-1 opacity-80">(<%= Number(counts.agendada) || 0 %>)</span>
              </a>
              <a href="/biblioteca/agendar?aba=viralizadas"
                class="rounded-md px-3.5 py-1.5 text-sm <%= abaAtual === 'viralizadas' ? 'bg-rose-500 font-semibold text-slate-950' : 'text-slate-300 hover:text-white' %>"
                role="tab" aria-selected="<%= abaAtual === 'viralizadas' ? 'true' : 'false' %>">
                Viralizadas
                <span class="ml-1 opacity-80">(<%= Number(counts.viralizadas) || viralList.length || 0 %>)</span>
              </a>
              <a href="/biblioteca/agendar?aba=publicadas"
                class="rounded-md px-3.5 py-1.5 text-sm <%= abaAtual === 'publicadas' ? 'bg-emerald-500 font-semibold text-slate-950' : 'text-slate-300 hover:text-white' %>"
                role="tab" aria-selected="<%= abaAtual === 'publicadas' ? 'true' : 'false' %>">
                Publicadas
                <span class="ml-1 opacity-80">(<%= Number(counts.publicadas) || 0 %>)</span>
              </a>
            </div>
            <% if (abaAtual === 'agendada') { %>
              <label class="inline-flex cursor-pointer items-center gap-2 text-xs text-slate-400 hover:text-slate-200">
                <input type="checkbox" id="agenda-check-all" class="rounded border-slate-600 bg-slate-950 text-amber-500 focus:ring-amber-500/30" />
                Selecionar todos
              </label>
              <span id="agenda-selecao" class="hidden rounded-md bg-amber-500/15 px-2 py-1 text-[11px] font-semibold text-amber-300"></span>
            <% } %>
          </div>

          <% if (abaAtual === 'agendada') { %>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" id="agenda-lote-confirmar" class="rounded-lg border border-sky-500/40 bg-sky-500/10 px-3 py-1.5 text-xs font-semibold text-sky-300 hover:bg-sky-500/20 disabled:opacity-40" disabled>Confirmar</button>
              <button type="button" id="agenda-lote-publicar" class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-300 hover:bg-emerald-500/20 disabled:opacity-40" disabled>Publicar</button>
              <button type="button" id="agenda-lote-excluir" class="rounded-lg border border-rose-500/40 bg-rose-500/10 px-3 py-1.5 text-xs font-semibold text-rose-300 hover:bg-rose-500/20 disabled:opacity-40" disabled>Excluir</button>
            </div>
          <% } %>
        </div>
      </div>

      <% if (abaAtual === 'viralizadas') { %>
        <p class="mt-3 text-xs text-slate-500">
          Mesmas matérias de <a href="/minhas-materias?status=viralizou" class="text-rose-300 hover:underline">Matérias → Viralizou</a>
          (todas as Páginas). Ao agendar, a IA cria uma <strong class="text-slate-300">nova matéria</strong> no estilo da sua marca — sem plagiar o post original.
          <span id="agenda-count" class="text-slate-400">(<%= viralList.length %> nesta lista)</span>
        </p>
        <div class="mt-2 overflow-hidden rounded-xl border border-slate-800 bg-slate-900/40">
          <ul id="agenda-viral-list" class="divide-y divide-slate-800/80">
            <% if (!viralList.length) { %>
              <li class="px-4 py-10 text-center text-sm text-slate-500">
                Nenhuma viralizada com engajamento no banco ainda.
                Abra <a href="/minhas-materias?status=viralizou" class="text-rose-300 hover:underline">Matérias → Viralizou</a>
                (isso sincroniza curtidas/comentários de <strong class="text-slate-300">todas</strong> as Páginas: Apocalipse, JM, etc.) e volte aqui.
                Recarregar esta aba também sincroniza — pode levar alguns segundos.
              </li>
            <% } %>
            <% viralList.forEach(function (v) {
              const origemPageId = Number(v.facebook_page_id) || 0;
              let preferId = defPageId;
              if (preferId && Number(preferId) === origemPageId && pagesList.length > 1) {
                const other = pagesList.find(function (p) { return Number(p.id) !== origemPageId; });
                if (other) preferId = other.id;
              } else if (!preferId && pagesList.length) {
                const other = pagesList.find(function (p) { return Number(p.id) !== origemPageId; });
                preferId = other ? other.id : pagesList[0].id;
              }
            %>
              <li class="viral-row flex flex-wrap items-start gap-3 px-3 py-3 hover:bg-slate-900/50" data-matter-id="<%= v.id %>">
                <% if (v.thumb) { %>
                  <img src="<%= v.thumb %>" alt="" class="h-14 w-14 shrink-0 rounded-lg object-cover ring-1 ring-slate-700" />
                <% } else { %>
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-[10px] text-slate-500">sem foto</div>
                <% } %>
                <div class="min-w-0 flex-1 space-y-1.5">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide <%= v.viral_label === 'Viralizou' ? 'bg-rose-500/20 text-rose-200 ring-1 ring-rose-500/30' : 'bg-amber-500/15 text-amber-200 ring-1 ring-amber-500/25' %>"><%= v.viral_label || 'Bom' %></span>
                    <% if (v.page_name) { %>
                      <span class="truncate text-[11px] text-slate-400">Origem: <%= v.page_name %></span>
                    <% } %>
                    <% if (v.ja_na_agenda) { %>
                      <span class="rounded px-1.5 py-0.5 text-[9px] text-slate-400 ring-1 ring-slate-600">Já na agenda (pode agendar em outra Página)</span>
                    <% } %>
                  </div>
                  <a href="/materias-ia/<%= v.id %>" class="block truncate text-sm font-medium text-white hover:text-rose-200"><%= v.titulo %></a>
                  <p class="text-[11px] text-slate-500">
                    <%= fmtNum(v.likes) %> curtidas · <%= fmtNum(v.comments) %> coment. · <%= fmtNum(v.views) %> views
                    <% if (v.published_at) { %> · <%= fmtQuando(v.published_at) %><% } %>
                    <% if (v.fb_post_url) { %>
                      · <a href="<%= v.fb_post_url %>" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">Ver no FB</a>
                    <% } %>
                  </p>
                  <div class="flex flex-wrap items-end gap-2 pt-1">
                    <label class="block min-w-[10rem] flex-1">
                      <span class="text-[10px] font-medium uppercase tracking-wide text-slate-500">Publicar em</span>
                      <select class="viral-page mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-1.5 text-xs text-white"
                        data-origem-page="<%= origemPageId %>">
                        <% pagesList.forEach(function (p) {
                          const sel = Number(preferId) === Number(p.id);
                        %>
                          <option value="<%= p.id %>" <%= sel ? 'selected' : '' %>><%= p.page_name %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label class="block">
                      <span class="text-[10px] font-medium uppercase tracking-wide text-slate-500">Horário</span>
                      <input type="datetime-local" class="viral-hora mt-1 rounded-md border border-slate-700 bg-slate-950 px-2 py-1.5 text-xs text-white"
                        value="<%= defaultProposedLocal %>" />
                    </label>
                    <button type="button"
                      class="viral-btn-agendar rounded-md border border-rose-500/40 bg-rose-500/15 px-3 py-1.5 text-[11px] font-semibold text-rose-100 hover:bg-rose-500/25"
                      data-id="<%= v.id %>">
                      Reescrever e agendar
                    </button>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } else { %>
      <p class="mt-3 text-xs text-slate-500">
        <% if (abaAtual === 'agendada') { %>
          Pré-agendadas e já agendadas (confirmadas) — mesmas que aparecem em Matérias salvas. <span id="agenda-count" class="text-slate-400">(<%= lista.length %> nesta lista)</span>
        <% } else { %>
          Já publicadas no Facebook. <span id="agenda-count" class="text-slate-400">(<%= lista.length %> nesta lista)</span>
        <% } %>
      </p>

      <div class="mt-2 overflow-hidden rounded-xl border border-slate-800 bg-slate-900/40">
        <ul id="agenda-list" class="divide-y divide-slate-800/80">
          <% if (!lista.length) { %>
            <li id="agenda-empty" class="px-4 py-10 text-center text-sm text-slate-500">
              <% if (abaAtual === 'publicadas') { %>
                Nenhuma publicação ainda nesta agenda.
              <% } else { %>
                Nenhuma pré-agenda ainda. Clique em <strong class="text-slate-300">Montar agenda de amanhã</strong> ou use a aba <strong class="text-rose-300">Viralizadas</strong>.
              <% } %>
            </li>
          <% } %>
          <% grupos.forEach(function (g) { %>
            <li class="agenda-day flex items-center justify-between gap-3 border-b border-slate-800 bg-slate-900/70 px-3 py-1.5" data-day="<%= g.dia %>">
              <span class="text-[11px] font-semibold uppercase tracking-wide text-amber-300/90"><%= rotuloDia(g.dia) %></span>
              <span class="agenda-day-count text-[11px] tabular-nums text-slate-500"><%= g.itens.length %></span>
            </li>
          <% g.itens.forEach(function (item) {
            const st = item.status || 'pendente';
            const uiSt = item.ui_status || (st === 'confirmado' ? 'agendada' : st);
            const thumb = item.thumb || item.post_thumbnail || '';
            const titulo = item.titulo || item.matter_titulo || item.post_titulo || 'Sem título';
            const canArte = Boolean(item.can_edit_arte && item.matter_id);
            const matterId = item.matter_id || '';
          %>
            <li class="agenda-row flex flex-wrap items-start gap-3 px-3 py-3 transition-colors hover:bg-slate-900/50" data-id="<%= item.id %>" data-day="<%= g.dia %>" data-status="<%= st %>" data-matter-id="<%= matterId %>">
              <% if (abaAtual === 'agendada') { %>
                <label class="mt-5 shrink-0">
                  <input type="checkbox" class="agenda-check rounded border-slate-600 bg-slate-950 text-amber-500 focus:ring-amber-500/30" value="<%= item.id %>" />
                </label>
              <% } %>
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border <%= st === 'publicado' ? 'border-emerald-500/25 bg-emerald-500/10' : 'border-amber-500/25 bg-amber-500/10' %>">
                <span class="agenda-hora-badge text-[15px] font-semibold tabular-nums <%= st === 'publicado' ? 'text-emerald-200' : 'text-amber-200' %>" data-id="<%= item.id %>"><%= horaCurta(item) %></span>
              </div>
              <% if (thumb) { %>
                <img src="<%= thumb %>" alt="" class="agenda-thumb h-14 w-14 shrink-0 rounded-lg object-cover ring-1 ring-slate-700" data-matter-id="<%= matterId %>" />
              <% } else { %>
                <div class="agenda-thumb-empty flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-[10px] text-slate-500" data-matter-id="<%= matterId %>">sem foto</div>
              <% } %>
              <div class="min-w-0 flex-1 space-y-1.5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded px-1.5 py-0.5 text-[9px] font-medium uppercase tracking-wide <%= statusClass[uiSt] || statusClass[st] || statusClass.pendente %>"><%= statusLabels[uiSt] || statusLabels[st] || st %></span>
                  <% if (item.is_viral_origem || item.source_matter_id) { %>
                    <span class="rounded px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide bg-rose-500/15 text-rose-200 ring-1 ring-rose-500/25" title="<%= item.source_matter_titulo || '' %>">Variação viral<%= item.source_page_name ? ' · ' + item.source_page_name : '' %></span>
                  <% } %>
                  <% if (item.fonte_nome) { %>
                    <span class="truncate text-[11px] text-slate-500"><%= item.fonte_nome %></span>
                  <% } %>
                  <% if (item.matched_keyword && item.matched_keyword !== 'viralizada') { %>
                    <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] text-emerald-300"><%= item.matched_keyword %></span>
                  <% } %>
                </div>
                <a href="<%= matterId ? '/materias-ia/' + matterId : (item.post_id ? '/biblioteca/posts/' + item.post_id : '#') %>" class="block truncate text-sm font-medium text-white hover:text-amber-200"><%= titulo %></a>
                <div class="flex flex-wrap items-center gap-2">
                  <input type="datetime-local" class="agenda-hora rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200 <%= st === 'publicado' ? 'opacity-50' : '' %>"
                    value="<%= String(item.proposed_at_local || '').slice(0, 16) %>"
                    data-id="<%= item.id %>"
                    <%= st === 'publicado' ? 'disabled' : '' %> />
                </div>

                <% if (canArte && abaAtual === 'agendada') { %>
                  <details class="agenda-arte group rounded-lg border border-slate-800/80 bg-slate-950/40">
                    <summary class="cursor-pointer list-none px-2.5 py-1.5 text-[11px] font-semibold text-violet-200 hover:text-violet-100 [&::-webkit-details-marker]:hidden">
                      Ajustar título e imagem ▾
                    </summary>
                    <div class="space-y-3 border-t border-slate-800 px-2.5 py-2.5">
                      <div class="space-y-1.5">
                        <label class="block text-[10px] font-medium uppercase tracking-wide text-slate-500">Título</label>
                        <input type="text" class="agenda-titulo-input w-full rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-sm text-slate-100" value="<%= String(titulo).replace(/"/g, '&quot;') %>" data-matter-id="<%= matterId %>" />
                        <div class="flex flex-wrap items-center gap-2">
                          <label class="flex items-center gap-1.5 text-[11px] text-slate-500">
                            <span>Tom</span>
                            <select class="agenda-titulo-tom rounded border border-slate-600 bg-slate-900 px-2 py-1 text-[11px] text-slate-300" data-matter-id="<%= matterId %>">
                              <option value="natural" selected>Natural</option>
                              <option value="polemico">Polêmico (forte)</option>
                              <option value="direto">Direto</option>
                              <option value="curiosidade">Curiosidade</option>
                              <option value="emocional">Emocional</option>
                              <option value="factual">Factual</option>
                            </select>
                          </label>
                          <button type="button" class="agenda-btn-sugerir-titulo rounded border border-slate-600 px-2 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-sky-300" data-matter-id="<%= matterId %>">Sugerir título</button>
                          <button type="button" class="agenda-btn-salvar-titulo rounded border border-emerald-500/40 bg-emerald-500/10 px-2 py-1 text-[11px] font-semibold text-emerald-300 hover:bg-emerald-500/20" data-matter-id="<%= matterId %>">Salvar título</button>
                        </div>
                      </div>
                      <div class="space-y-1.5">
                        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">Trocar imagem</p>
                        <p class="agenda-img-meta text-[10px] text-slate-500" data-matter-id="<%= matterId %>">Abra e clique em buscar — Fotos via Brave / Serper · clique numa miniatura para trocar a arte</p>
                        <div class="agenda-img-strip flex max-h-[6.5rem] flex-wrap gap-1 overflow-y-auto" data-matter-id="<%= matterId %>"></div>
                        <button type="button" class="agenda-btn-buscar-imgs w-full rounded border border-violet-500/40 px-2.5 py-1.5 text-[11px] font-semibold text-violet-200 hover:bg-violet-500/10" data-matter-id="<%= matterId %>">Buscar fotos (Brave / Serper)</button>
                      </div>
                      <p class="agenda-arte-status text-[10px] text-slate-500" data-matter-id="<%= matterId %>"></p>
                    </div>
                  </details>
                <% } %>
              </div>
              <div class="flex w-full shrink-0 flex-wrap gap-1.5 sm:w-auto sm:justify-end">
                <% if (item.matter_id) { %>
                  <a href="/materias-ia/<%= item.matter_id %>" target="_blank" rel="noopener noreferrer" class="rounded-md border border-slate-700 px-2 py-1 text-[11px] font-medium text-slate-300 hover:border-slate-500 hover:text-white"><%= abaAtual === 'publicadas' ? 'Ver' : 'Editar' %></a>
                  <% if (st === 'pendente' || st === 'confirmado') { %>
                    <button type="button" class="agenda-btn-publicar rounded-md border border-emerald-500/40 bg-emerald-500/10 px-2 py-1 text-[11px] font-semibold text-emerald-300 hover:bg-emerald-500/20" data-id="<%= item.id %>">Publicar</button>
                  <% } %>
                <% } else if (item.post_id) { %>
                  <a href="/biblioteca/posts/<%= item.post_id %>" target="_blank" rel="noopener noreferrer" class="rounded-md border border-slate-700 px-2 py-1 text-[11px] font-medium text-slate-300 hover:border-slate-500 hover:text-white">Ver</a>
                <% } %>
                <% if (st === 'pendente') { %>
                  <button type="button" class="agenda-btn-confirmar rounded-md border border-sky-500/40 bg-sky-500/10 px-2 py-1 text-[11px] font-semibold text-sky-300 hover:bg-sky-500/20" data-id="<%= item.id %>">Confirmar</button>
                <% } %>
                <% if (st !== 'publicado') { %>
                  <button type="button" class="agenda-btn-excluir rounded-md border border-rose-500/40 bg-rose-500/10 px-2 py-1 text-[11px] font-semibold text-rose-300 hover:bg-rose-500/20" data-id="<%= item.id %>">Excluir</button>
                <% } %>
              </div>
            </li>
          <% }) %>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </section>
  </main>

  <div id="agenda-busy" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-950/80 p-6 backdrop-blur-sm">
    <div class="w-full max-w-sm rounded-2xl border border-slate-700 bg-slate-900 p-6 text-center shadow-2xl">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-2 border-amber-400/30 border-t-amber-300"></div>
      <p id="agenda-busy-text" class="mt-4 text-sm text-slate-300">Processando…</p>
    </div>
  </div>

  <style>
    .agenda-hora { color-scheme: dark; }
    .agenda-hora::-webkit-calendar-picker-indicator {
      position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer;
    }
    .viral-hora { color-scheme: dark; }
  </style>
  <script src="/js/biblioteca-agendar.js?v=20260730g"></script>
<%- include('partials/app-end') %>
