<%- include('partials/app-start') %>
<%
  const listaEixos = Array.isArray(eixos) ? eixos : [];
  const pagina = paginaPadrao || null;
%>

<main class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-8" id="virais-page" data-pagina-id="<%= pagina?.id || '' %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold text-white sm:text-2xl">Virais</h1>
        <span class="rounded-full border border-orange-500/30 bg-orange-500/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-orange-300">Claude editorial</span>
      </div>
      <p class="mt-1 max-w-3xl text-sm text-slate-400">
        Pesquisa pautas recentes para o público da JM Notícia e transforma as escolhidas em matérias completas, com fontes, hashtags e títulos alternativos.
      </p>
    </div>
    <a href="/minhas-materias?status=rascunho" class="rounded-lg border border-slate-700 px-3 py-2 text-xs font-medium text-slate-300 transition hover:border-emerald-500 hover:text-emerald-300">
      Abrir rascunhos
    </a>
  </div>

  <% if (!pagina) { %>
    <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-100">
      Defina uma página padrão antes de usar este módulo.
      <a href="/paginas" class="font-semibold text-amber-300 underline underline-offset-2">Configurar em Páginas</a>
    </div>
  <% } else { %>
    <div class="mt-3 inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/50 px-3 py-2 text-xs text-slate-400">
      <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
      Página analisada: <strong class="font-medium text-slate-200"><%= pagina.nome %></strong>
    </div>
  <% } %>

  <section class="mt-5 grid gap-3 lg:grid-cols-[1.25fr_.75fr]">
    <div class="rounded-xl border border-slate-800 bg-slate-900/45 p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Perfil comprovado do público</p>
      <h2 class="mt-1 text-base font-semibold text-white">Pentecostal brasileiro, com forte interesse em Assembleia de Deus</h2>
      <p class="mt-2 text-sm leading-6 text-slate-400">
        A seleção prioriza conflito e decisão denominacional, memória pentecostal, escatologia e polêmicas gospel. Histórias universais, fé e ciência e testemunhos com esperança entram como apostas de alto retorno.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-[11px]">
        <span class="rounded-md bg-emerald-500/10 px-2 py-1 text-emerald-300">7 pautas do eixo principal</span>
        <span class="rounded-md bg-sky-500/10 px-2 py-1 text-sky-300">3 apostas do eixo secundário</span>
        <span class="rounded-md bg-violet-500/10 px-2 py-1 text-violet-300">Foco em compartilhamento</span>
      </div>
    </div>
    <div class="rounded-xl border border-slate-800 bg-slate-900/45 p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">O sistema evita</p>
      <ul class="mt-2 space-y-1.5 text-xs leading-5 text-slate-400">
        <li>• Política sem ângulo religioso central</li>
        <li>• Notícia local de Tocantins</li>
        <li>• Reflexão genérica sem fato novo</li>
        <li>• Tragédia sem superação ou esperança</li>
        <li>• Pauta já usada ou sem fonte verificável</li>
      </ul>
    </div>
  </section>

  <section class="mt-4 rounded-xl border border-slate-800 bg-slate-900/45 p-4">
    <form id="virais-search-form" class="grid gap-3 md:grid-cols-[1.2fr_.55fr_.55fr_auto] md:items-end">
      <label class="text-xs font-medium text-slate-400">
        Segmento da pauta
        <select id="virais-eixo" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white outline-none focus:border-emerald-500">
          <option value="all">Todos — 7 principais + 3 secundários</option>
          <optgroup label="Eixo principal">
            <% listaEixos.filter((e) => e.grupo === 'principal').forEach((eixo) => { %>
              <option value="<%= eixo.id %>"><%= eixo.nome %></option>
            <% }) %>
          </optgroup>
          <optgroup label="Eixo secundário">
            <% listaEixos.filter((e) => e.grupo === 'secundario').forEach((eixo) => { %>
              <option value="<%= eixo.id %>"><%= eixo.nome %></option>
            <% }) %>
          </optgroup>
        </select>
      </label>
      <label class="text-xs font-medium text-slate-400">
        Período
        <select id="virais-periodo" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white outline-none focus:border-emerald-500">
          <option value="24h">Últimas 24 horas</option>
          <option value="3d">Últimos 3 dias</option>
          <option value="7d" selected>Últimos 7 dias</option>
        </select>
      </label>
      <label class="text-xs font-medium text-slate-400">
        Tom da matéria
        <select id="virais-tom" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white outline-none focus:border-emerald-500">
          <option value="natural">Natural</option>
          <option value="direto">Direto</option>
          <option value="emocional">Emocional</option>
          <option value="polemico">Polêmico</option>
          <option value="factual">Factual</option>
        </select>
      </label>
      <button type="submit" <%= pagina ? '' : 'disabled' %> class="rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-40">
        Pesquisar pautas
      </button>
      <label class="md:col-span-4 text-xs font-medium text-slate-400">
        Assunto específico (opcional)
        <input id="virais-termo" type="search" placeholder="Ex.: Silas Malafaia, CGADB, música gospel…" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder:text-slate-600 outline-none focus:border-emerald-500" />
      </label>
    </form>
  </section>

  <div id="virais-status" class="mt-3 min-h-5 text-xs text-slate-500" aria-live="polite"></div>

  <section id="virais-results" class="mt-2 hidden">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 class="text-base font-semibold text-white">Pautas encontradas</h2>
        <p id="virais-resumo" class="mt-0.5 text-xs text-slate-500"></p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="virais-selecionar" class="rounded-lg border border-slate-700 px-3 py-2 text-xs text-slate-300 hover:border-slate-500 hover:text-white">Selecionar 3 melhores</button>
        <button type="button" id="virais-gerar" disabled class="rounded-lg bg-orange-500 px-3 py-2 text-xs font-semibold text-white transition hover:bg-orange-400 disabled:cursor-not-allowed disabled:opacity-40">Criar com Claude</button>
      </div>
    </div>
    <div id="virais-list" class="mt-3 grid gap-3"></div>
  </section>

  <section id="virais-created" class="mt-5 hidden rounded-xl border border-emerald-500/25 bg-emerald-500/5 p-4">
    <h2 class="text-base font-semibold text-emerald-200">Matérias criadas</h2>
    <p id="virais-created-message" class="mt-1 text-xs text-slate-400"></p>
    <div id="virais-created-list" class="mt-3 grid gap-3"></div>
  </section>
</main>

<script src="/js/virais.js?v=20260824jm1"></script>
<%- include('partials/app-end') %>
