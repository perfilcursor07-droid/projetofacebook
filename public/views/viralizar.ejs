<%- include('partials/app-start') %>
<%
  const perfilNome = (perfil && perfil.nome) || 'sua página';
  const slotLabel = (slotSugerido && slotSugerido.label) || 'Terça/quarta 12h–16h';
%>

  <main class="mx-auto max-w-9xl px-4 py-5 sm:px-6 sm:py-8">
    <%- include('partials/content-nav', { contentTab: 'viralizar' }) %>

    <div class="flex flex-wrap items-start justify-between gap-3">
      <p class="max-w-2xl text-sm text-slate-400">
        Pautas com potencial de engajar em
        <strong class="font-medium text-slate-300"><%= perfilNome %></strong>
        e o desempenho do que você já publicou.
      </p>
      <span class="shrink-0 rounded-lg border border-rose-500/20 bg-rose-500/10 px-3 py-1.5 text-xs text-rose-200">
        Melhor horário: <%= slotLabel %>
      </span>
    </div>

    <!-- Toolbar: abas + ações (sem repetir “Buscar pautas”) -->
    <div class="mt-4 flex flex-col gap-3 rounded-xl border border-slate-800 bg-slate-900/40 p-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <div class="inline-flex rounded-lg border border-slate-700 bg-slate-950 p-0.5" role="tablist" aria-label="Seção Viralizar">
        <button type="button" id="vir-view-pautas" data-vir-view="pautas"
          class="vir-view-btn rounded-md bg-rose-500 px-3.5 py-2 text-sm font-semibold text-white" role="tab" aria-selected="true">
          Pautas virais
        </button>
        <button type="button" id="vir-view-desempenho" data-vir-view="desempenho"
          class="vir-view-btn rounded-md px-3.5 py-2 text-sm text-slate-300 hover:text-white" role="tab" aria-selected="false">
          Desempenho
        </button>
      </div>

      <div id="vir-toolbar-pautas" class="flex flex-wrap items-center gap-2">
        <button type="button" id="vir-btn-curar"
          class="rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-400 disabled:opacity-50">
          Buscar agora
        </button>
        <select id="vir-tipo" class="rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100">
          <option value="foto" selected>Foto + legenda</option>
          <option value="texto">Só texto</option>
        </select>
        <label class="inline-flex items-center gap-2 text-sm text-slate-400">
          <input type="checkbox" id="vir-auto-pub" class="accent-rose-500" />
          Publicar ao gerar
        </label>
      </div>

      <div id="vir-toolbar-desempenho" class="hidden flex flex-wrap items-center gap-2">
        <button type="button" id="vir-btn-desempenho"
          class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400 disabled:opacity-50">
          Analisar página
        </button>
        <button type="button" id="vir-btn-desempenho-refresh"
          class="rounded-lg border border-slate-600 px-3 py-2 text-xs text-slate-300 hover:border-slate-400 hover:text-white">
          Atualizar views
        </button>
      </div>
    </div>

    <div id="vir-meta-pautas">
      <p id="vir-cache-info" class="mt-2 hidden text-xs leading-relaxed text-slate-500"></p>
      <p id="vir-status" class="mt-2 min-h-[1.25rem] text-xs text-slate-500"></p>
    </div>
    <p id="vir-desempenho-status" class="mt-2 hidden min-h-[1.25rem] text-xs text-slate-500"></p>

    <!-- ABA 1: PAUTAS -->
    <section id="vir-pane-pautas">

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <div id="vir-tabs" class="hidden inline-flex flex-wrap rounded-xl border border-slate-700 bg-slate-900 p-1" role="tablist">
          <button type="button" data-vir-tab="todos" class="vir-tab-btn rounded-lg bg-rose-500 px-3 py-1.5 text-sm font-semibold text-white">
            Todos <span class="vir-tab-count opacity-80" data-count-for="todos"></span>
          </button>
          <button type="button" data-vir-tab="noticia" class="vir-tab-btn rounded-lg px-3 py-1.5 text-sm text-slate-300 hover:text-white">
            Notícias <span class="vir-tab-count opacity-70" data-count-for="noticia"></span>
          </button>
          <button type="button" data-vir-tab="instagram" class="vir-tab-btn rounded-lg px-3 py-1.5 text-sm text-slate-300 hover:text-white">
            Instagram <span class="vir-tab-count opacity-70" data-count-for="instagram"></span>
          </button>
          <button type="button" data-vir-tab="facebook" class="vir-tab-btn rounded-lg px-3 py-1.5 text-sm text-slate-300 hover:text-white">
            Facebook <span class="vir-tab-count opacity-70" data-count-for="facebook"></span>
          </button>
          <button type="button" data-vir-tab="alto" class="vir-tab-btn rounded-lg px-3 py-1.5 text-sm text-slate-300 hover:text-white">
            Alto potencial <span class="vir-tab-count opacity-70" data-count-for="alto"></span>
          </button>
        </div>

        <div id="vir-lote-bar" class="hidden flex flex-wrap items-center gap-2">
          <button type="button" id="vir-btn-sel-todos"
            class="rounded-lg border border-slate-600 px-3 py-1.5 text-xs text-slate-300 hover:border-slate-400 hover:text-white">
            Marcar todos
          </button>
          <button type="button" id="vir-btn-sel-limpar"
            class="rounded-lg border border-slate-600 px-3 py-1.5 text-xs text-slate-300 hover:border-slate-400 hover:text-white">
            Limpar
          </button>
          <button type="button" id="vir-btn-gerar" disabled
            class="rounded-lg border border-violet-500/50 bg-violet-500/15 px-3 py-1.5 text-xs font-medium text-violet-200 hover:border-violet-400 disabled:opacity-40">
            Gerar selecionados
          </button>
          <span id="vir-sel-count" class="text-[11px] text-slate-500"></span>
        </div>
      </div>

      <div id="vir-lista" class="mt-4 space-y-3"></div>

      <details id="vir-excluidos-wrap" class="mt-6 hidden rounded-xl border border-slate-800 bg-slate-900/30 px-4 py-3">
        <summary class="cursor-pointer text-xs text-slate-400">Pautas já usadas nesta página</summary>
        <div id="vir-excluidos" class="mt-3 space-y-1.5"></div>
      </details>
    </section>

    <!-- ABA 2: DESEMPENHO -->
    <section id="vir-pane-desempenho" class="hidden">
      <div id="vir-desempenho-resumo" class="mt-2 hidden grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
      <div id="vir-desempenho-lista" class="mt-4 space-y-2"></div>
    </section>
  </main>

  <div id="vir-generating" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 p-6 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-2xl border border-rose-500/30 bg-slate-900 p-8 text-center shadow-xl">
      <div class="mx-auto h-12 w-12 animate-spin rounded-full border-2 border-rose-400/30 border-t-rose-300"></div>
      <h2 class="mt-5 text-lg font-semibold text-white">Gerando matéria…</h2>
      <p id="vir-generating-text" class="mt-2 text-sm text-slate-400">Apurando fontes e montando o conteúdo.</p>
    </div>
  </div>

  <script src="/js/viralizar.js"></script>
<%- include('partials/app-end') %>
