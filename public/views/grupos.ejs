<%- include('partials/app-start') %>

  <main class="mx-auto max-w-9xl px-3 py-4 sm:px-6 sm:py-8" id="grupos-app"
    data-ayrshare="<%= ayrshareConfigured ? '1' : '0' %>">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400/80">Distribuição</p>
        <h1 class="mt-1 text-2xl font-semibold text-white">Grupos do Facebook</h1>
        <p class="mt-1 max-w-2xl text-sm text-slate-400">
          Cadastre seus grupos, organize por nicho e marque os padrão. Ao publicar uma matéria na Página,
          você pode repostar nos grupos selecionados — a publicação sai pelo Ayrshare.
        </p>
      </div>
      <button type="button" id="btn-novo"
        class="shrink-0 rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400">
        + Novo grupo
      </button>
    </div>

    <% if (!ayrshareConfigured) { %>
      <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
        O Ayrshare não está configurado (<code>AYRSHARE_API_KEY</code>). Você pode cadastrar e organizar os grupos,
        mas a publicação automática só funciona com o Ayrshare ativo.
      </div>
    <% } %>

    <div class="mt-4 rounded-xl border border-sky-500/25 bg-sky-500/5 px-4 py-3 text-xs leading-relaxed text-slate-300">
      <strong class="font-semibold text-sky-200">Como conectar um grupo:</strong>
      no painel <a href="https://app.ayrshare.com" target="_blank" rel="noopener" class="text-sky-300 underline">app.ayrshare.com</a>
      → Social Accounts, conecte o Grupo do Facebook. Cada grupo fica sob um <em>User Profile</em> com sua
      <strong class="font-medium text-slate-200">Profile-Key</strong>. Cole essa chave no cadastro do grupo abaixo.
    </div>

    <div id="grupos-status" class="mt-4 hidden rounded-lg px-4 py-2.5 text-sm"></div>

    <!-- Barra de filtro por nicho -->
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Nicho:</span>
      <div id="filtro-nichos" class="flex flex-wrap gap-1.5"></div>
    </div>

    <div id="grupos-lista" class="mt-4 space-y-5"></div>

    <p id="grupos-vazio" class="mt-8 hidden rounded-xl border border-dashed border-slate-700 px-4 py-12 text-center text-sm text-slate-400">
      Nenhum grupo cadastrado ainda. Clique em <strong class="text-slate-200">Novo grupo</strong> para começar.
    </p>
  </main>

  <!-- Modal de cadastro/edição -->
  <div id="grupo-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-5 shadow-xl">
      <div class="flex items-center justify-between gap-3">
        <h2 id="modal-titulo" class="text-lg font-semibold text-white">Novo grupo</h2>
        <button type="button" id="modal-fechar" class="rounded-lg p-1 text-slate-400 hover:text-white" aria-label="Fechar">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <form id="grupo-form" class="mt-4 space-y-3">
        <input type="hidden" id="g-id" />
        <label class="block text-sm">
          <span class="text-slate-400">Nome do grupo *</span>
          <input id="g-nome" type="text" maxlength="200" required
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="text-slate-400">Nicho</span>
            <input id="g-nicho" type="text" maxlength="120" list="nichos-existentes" placeholder="ex.: gospel, política, humor"
              class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
            <datalist id="nichos-existentes"></datalist>
          </label>
          <label class="block text-sm">
            <span class="text-slate-400">Link do grupo</span>
            <input id="g-url" type="url" maxlength="500" placeholder="https://www.facebook.com/groups/..."
              class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
          </label>
        </div>
        <label class="block text-sm">
          <span class="text-slate-400">Ayrshare Profile-Key</span>
          <input id="g-key" type="text" maxlength="200" placeholder="chave do User Profile que tem este grupo conectado"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 focus:border-emerald-500 focus:outline-none" />
          <span class="mt-1 block text-[11px] text-slate-500">Sem a chave o grupo fica só organizado — não publica.</span>
        </label>
        <label class="block text-sm">
          <span class="text-slate-400">Observações</span>
          <textarea id="g-obs" rows="2" maxlength="1000"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-emerald-500 focus:outline-none"></textarea>
        </label>
        <div class="flex flex-wrap gap-4">
          <label class="inline-flex items-center gap-2 text-sm text-slate-300">
            <input id="g-padrao" type="checkbox" class="accent-emerald-500" /> Selecionar por padrão ao publicar
          </label>
          <label class="inline-flex items-center gap-2 text-sm text-slate-300">
            <input id="g-ativo" type="checkbox" class="accent-emerald-500" checked /> Ativo
          </label>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="modal-cancelar" class="rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-slate-500 hover:text-white">Cancelar</button>
          <button type="submit" id="modal-salvar" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/grupos.js?v=20260804a"></script>
<%- include('partials/app-end') %>
