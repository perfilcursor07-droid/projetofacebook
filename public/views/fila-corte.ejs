<%- include('partials/app-start') %>
<%
  const canEdit = clip.status === 'pronto' || clip.status === 'publicado';
  const videoUrl = clip.caminho_arquivo ? '/media/' + String(clip.caminho_arquivo).replace(/^\/+/, '') : '';
  const inicio = Number(clip.inicio_segundo);
  const fim = Number(clip.fim_segundo);
  const dur = Number.isFinite(inicio) && Number.isFinite(fim) ? Math.max(0, Math.round(fim - inicio)) : null;
  const ratio = clip.aspect_ratio || '9:16';
  const materiaOk = Boolean(materia) && clip.materia_status === 'pronta';
  const splitAtivo = String(clip.layout || 'normal') === 'split';
  const splitGerando = clip.split_status === 'gerando';
  const videoOffset = Number(clip.split_video_offset);
  const imagemOffset = Number(clip.split_image_offset);
  const offsetVideo = Number.isFinite(videoOffset) ? videoOffset : 50;
  const offsetImagem = Number.isFinite(imagemOffset) ? imagemOffset : 50;
  const videoOffsetYRaw = Number(clip.split_video_offset_y);
  const imagemOffsetYRaw = Number(clip.split_image_offset_y);
  const offsetVideoY = Number.isFinite(videoOffsetYRaw) ? videoOffsetYRaw : 50;
  const offsetImagemY = Number.isFinite(imagemOffsetYRaw) ? imagemOffsetYRaw : 50;
  const videoZoomRaw = Number(clip.split_video_zoom);
  const imagemZoomRaw = Number(clip.split_image_zoom);
  const zoomVideo = Number.isFinite(videoZoomRaw) ? Math.min(160, Math.max(70, Math.round(videoZoomRaw))) : 100;
  const zoomImagem = Number.isFinite(imagemZoomRaw) ? Math.min(160, Math.max(70, Math.round(imagemZoomRaw))) : 100;
  const splitModo = clip.split_modo === 'empilhado' ? 'empilhado' : 'lado';
  const splitImagemPosRaw = String(clip.split_imagem_pos || '');
  const splitImagemPos = splitModo === 'empilhado'
    ? (splitImagemPosRaw === 'baixo' ? 'baixo' : 'cima')
    : (splitImagemPosRaw === 'direita' ? 'direita' : 'esquerda');
  const previewVideo = (typeof previewBaseUrl !== 'undefined' && previewBaseUrl) ? previewBaseUrl : videoUrl;
  const splitTexto = String(clip.split_texto || '');
  const splitTextoPos = ['topo', 'meio'].includes(clip.split_texto_posicao)
    ? clip.split_texto_posicao
    : (splitModo === 'empilhado' ? 'meio' : 'rodape');
  const splitTextoTamRaw = Number(clip.split_texto_tamanho);
  const splitTextoTam = Number.isFinite(splitTextoTamRaw)
    ? Math.min(160, Math.max(70, Math.round(splitTextoTamRaw)))
    : 100;
  const splitTextoFundo = clip.split_texto_fundo === 'transparente' ? 'transparente' : 'cor';
  const splitTextoFundoCor = /^#[0-9a-fA-F]{6}$/.test(String(clip.split_texto_fundo_cor || ''))
    ? String(clip.split_texto_fundo_cor).toLowerCase()
    : '#000000';
  const capaAtiva = clip.capa_status === 'pronta';
  const bgmPresetAtual = (typeof defaultBgmPreset !== 'undefined' ? defaultBgmPreset : 'nenhuma');
  const bgmPreset = String(clip.bgm_preset || bgmPresetAtual);
  const bgmVolRaw = Number(clip.bgm_volume);
  const bgmVolume = Number.isFinite(bgmVolRaw)
    ? Math.min(40, Math.max(5, Math.round(bgmVolRaw)))
    : (typeof defaultBgmVolume !== 'undefined' ? defaultBgmVolume : 18);
  const presetsLista = typeof bgmPresets !== 'undefined' && Array.isArray(bgmPresets) ? bgmPresets : [];
%>

  <main class="mx-auto max-w-8xl px-4 py-5 sm:px-6 sm:py-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <a href="/fila" class="text-xs font-medium text-slate-500 hover:text-emerald-300">← Voltar para Produção</a>
        <h1 class="mt-2 text-2xl font-semibold text-white">Revisar e publicar</h1>
        <p class="mt-1 text-sm text-slate-400 truncate max-w-xl"><%= video.titulo || video.termo_busca || 'Corte' %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <span><%= dur != null ? dur + 's' : '—' %></span>
        <span>·</span>
        <span><%= ratio %></span>
        <% if (splitAtivo) { %>
          <span class="rounded-full bg-fuchsia-500/15 px-2.5 py-0.5 font-medium text-fuchsia-300">Tela dividida</span>
        <% } %>
        <% if (clip.status === 'publicado') { %>
          <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-medium text-emerald-300">Publicado</span>
        <% } else if (materiaOk) { %>
          <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-medium text-emerald-300">Pronto</span>
        <% } else { %>
          <span class="rounded-full bg-amber-500/15 px-2.5 py-0.5 font-medium text-amber-200">Preparando…</span>
        <% } %>
      </div>
    </div>

    <p id="clip-status" class="mt-4 text-sm text-slate-400"></p>
    <% if (clip.erro_mensagem) { %>
      <div class="mt-3 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"><%= clip.erro_mensagem %></div>
    <% } %>
    <% if (clip.split_erro) { %>
      <div class="mt-3 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"><%= clip.split_erro %></div>
    <% } %>

    <% if (!canEdit) { %>
      <div class="mt-6 rounded-2xl border border-amber-500/25 bg-amber-500/10 p-6 text-center">
        <p class="text-sm text-amber-100">Este corte ainda está processando.</p>
        <a href="/fila" class="mt-3 inline-block text-sm text-sky-300 hover:underline">Voltar e aguardar →</a>
      </div>
    <% } else { %>
      <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="space-y-6">
          <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matéria</p>
              <button type="button" id="btn-materia" class="rounded-lg bg-violet-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-violet-400">
                <%= materia ? 'Refazer matéria' : 'Gerar matéria' %>
              </button>
            </div>
            <input id="clip-tema" type="text" placeholder="Tema opcional"
              class="mt-3 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none" />
            <textarea id="clip-materia" rows="12"
              class="mt-3 w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm leading-relaxed text-slate-100 focus:border-emerald-500 focus:outline-none"
              placeholder="A matéria aparece aqui…"><%= materia || '' %></textarea>

            <div class="mt-4 space-y-3 rounded-xl border border-sky-500/20 bg-slate-950/50 p-3">
              <label class="flex cursor-pointer items-start gap-3">
                <input id="clip-capa-ativa" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500/40"
                  <%= capaAtiva ? 'checked' : '' %> />
                <span>
                  <span class="block text-sm font-medium text-slate-200">Incluir capa no início do Reel</span>
                  <span class="mt-0.5 block text-[11px] text-slate-500">Desmarque para publicar/ver só o vídeo, sem a intro da capa.</span>
                </span>
              </label>
              <div id="clip-capa-campos" class="space-y-3">
                <div class="flex flex-wrap items-end gap-2">
                  <label class="min-w-0 flex-1">
                    <span class="text-[11px] text-slate-500">Título da capa</span>
                    <input id="clip-capa-titulo" type="text" maxlength="120" value="<%= clip.capa_titulo || '' %>"
                      placeholder="Título da capa"
                      class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm font-semibold text-white focus:border-emerald-500 focus:outline-none" />
                  </label>
                  <label class="w-[8.5rem] shrink-0">
                    <span class="text-[11px] text-slate-500">Tom</span>
                    <select id="clip-capa-tom"
                      class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-2 py-2 text-xs text-white focus:border-sky-500 focus:outline-none">
                      <option value="natural">Natural</option>
                      <option value="polemico">Mais polêmico</option>
                      <option value="direto">Direto</option>
                      <option value="curiosidade">Curiosidade</option>
                      <option value="emocional">Emocional</option>
                      <option value="factual">Factual</option>
                    </select>
                  </label>
                  <button type="button" id="btn-capa-sugerir-titulo"
                    class="shrink-0 rounded-lg border border-violet-500/40 bg-violet-500/15 px-3 py-2 text-xs font-semibold text-violet-200 hover:bg-violet-500/25"
                    title="Cada clique gera um título novo">
                    Sugerir com IA
                  </button>
                </div>
                <p class="text-[11px] text-slate-600">Clique em <strong class="font-medium text-slate-500">Sugerir com IA</strong> várias vezes até gostar do título.</p>
                <div class="flex flex-wrap items-center gap-2">
                  <button type="button" id="btn-capa" class="rounded-lg border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-200 hover:bg-sky-500/25">
                    <%= capaAtiva ? 'Refazer capa' : 'Gerar capa' %>
                  </button>
                  <span id="capa-status-label" class="text-[11px] <%= capaAtiva ? 'text-emerald-300' : 'text-slate-600' %>">
                    <%= capaAtiva ? 'Capa ativa no vídeo' : 'Sem capa' %>
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- Tela dividida: imagem de um lado, vídeo do outro -->
          <section id="split-panel" class="rounded-2xl border border-fuchsia-500/25 bg-slate-900/60 p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="text-xs font-semibold uppercase tracking-wide text-fuchsia-300">Tela dividida</p>
                  <% if (splitGerando) { %>
                    <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-medium text-amber-200">Montando…</span>
                  <% } else if (splitAtivo) { %>
                    <span class="rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-medium text-emerald-300">Ativa</span>
                  <% } %>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-slate-500">
                  Duas opções: <strong class="font-medium text-slate-400">lado a lado</strong> ou
                  <strong class="font-medium text-slate-400">um em cima do outro</strong> (imagem/vídeo horizontal, texto no meio).
                </p>
              </div>
              <% if (splitAtivo) { %>
                <button type="button" id="btn-split-remover" class="shrink-0 rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:border-rose-500/50 hover:text-rose-200">
                  Remover
                </button>
              <% } %>
            </div>

            <div class="mt-3 inline-flex flex-wrap gap-1 rounded-xl border border-slate-700 bg-slate-950 p-1" role="tablist" aria-label="Layout da tela dividida">
              <button type="button" data-split-modo="lado"
                class="split-modo-btn rounded-lg px-3 py-1.5 text-xs <%= splitModo === 'lado' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-300 hover:text-white' %>">
                Lado a lado
              </button>
              <button type="button" data-split-modo="empilhado"
                class="split-modo-btn rounded-lg px-3 py-1.5 text-xs <%= splitModo === 'empilhado' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-300 hover:text-white' %>">
                Um em cima do outro
              </button>
            </div>

            <div class="mt-4 grid gap-4 sm:grid-cols-[210px_minmax(0,1fr)]">
              <div>
                <div id="split-preview" class="relative mx-auto flex aspect-[9/16] w-full max-w-[210px] overflow-hidden rounded-xl border border-slate-700 bg-black <%= splitModo === 'empilhado' ? 'flex-col' : '' %>"
                  style="<%= splitModo === 'empilhado' ? (splitImagemPos === 'baixo' ? 'flex-direction:column-reverse' : 'flex-direction:column') : (splitImagemPos === 'direita' ? 'flex-direction:row-reverse' : 'flex-direction:row') %>">
                  <div id="split-pane-img" class="relative overflow-hidden bg-slate-950 <%= splitModo === 'empilhado' ? 'h-1/2 w-full' : 'h-full w-1/2' %>">
                    <img id="split-img-preview" alt="" class="h-full w-full object-cover <%= splitImagemUrl ? '' : 'hidden' %>"
                      src="<%= splitImagemUrl || '' %>" style="object-position: <%= offsetImagem %>% <%= offsetImagemY %>%;" />
                    <div id="split-img-empty" class="absolute inset-0 flex items-center justify-center px-2 text-center text-[10px] leading-tight text-slate-600 <%= splitImagemUrl ? 'hidden' : '' %>">
                      Escolha a imagem
                    </div>
                  </div>
                  <div id="split-pane-vid" class="relative overflow-hidden bg-slate-950 <%= splitModo === 'empilhado' ? 'h-1/2 w-full' : 'h-full w-1/2' %>">
                    <% if (previewVideo) { %>
                      <video id="split-video-preview" class="h-full w-full object-cover" muted loop playsinline preload="metadata"
                        style="object-position: <%= offsetVideo %>% <%= offsetVideoY %>%;" src="<%= previewVideo %>#t=0.5"></video>
                    <% } %>
                  </div>
                  <span id="split-divider" class="pointer-events-none absolute bg-white/20 <%= splitModo === 'empilhado' ? 'inset-x-0 top-1/2 h-px -translate-y-1/2' : 'inset-y-0 left-1/2 w-px -translate-x-1/2' %>"></span>
                  <div id="split-texto-preview"
                    class="pointer-events-none absolute inset-x-0 <%= splitTextoPos === 'topo' ? 'top-0' : splitTextoPos === 'meio' ? 'top-1/2 -translate-y-1/2' : 'bottom-0' %> <%= splitTexto ? '' : 'hidden' %> <%= splitTextoPos === 'meio' ? 'bg-black/70 px-1.5 py-1.5' : 'bg-gradient-to-' + (splitTextoPos === 'topo' ? 'b' : 't') + ' from-black/80 to-black/40 px-1.5 py-1.5' %>">
                    <p id="split-texto-preview-p" class="text-center text-[8px] font-extrabold uppercase leading-snug tracking-wide text-white"><%= splitTexto %></p>
                  </div>
                </div>
                <div class="mt-2 flex items-center justify-center gap-2">
                  <button type="button" id="btn-split-play" class="rounded-lg border border-slate-700 px-2.5 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-emerald-300">Testar</button>
                  <button type="button" id="btn-split-lado" class="rounded-lg border border-slate-700 px-2.5 py-1 text-[11px] text-slate-300 hover:border-fuchsia-500 hover:text-fuchsia-200"
                    data-lado="<%= splitImagemPos %>"><%= splitModo === 'empilhado' ? (splitImagemPos === 'baixo' ? 'Imagem embaixo' : 'Imagem em cima') : (splitImagemPos === 'direita' ? 'Imagem à direita' : 'Imagem à esquerda') %></button>
                </div>
              </div>

              <div class="space-y-4">
                <div class="space-y-3 rounded-xl border border-slate-800 bg-slate-950/40 p-3">
                  <div>
                    <p class="text-[11px] font-medium text-slate-400">Enquadramento</p>
                    <p class="mt-1 text-[10px] leading-relaxed text-slate-600">
                      Use o zoom para <span class="text-slate-400">mostrar mais</span> (afastar) ou aproximar.
                      Depois empurre para os lados e para cima/baixo. Em 100% o ←→ às vezes não mexe — afaste ou aproxime um pouco.
                    </p>
                  </div>

                  <div class="rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-2.5 space-y-2.5">
                    <p class="text-[11px] font-semibold text-emerald-300">Vídeo</p>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        <span>Zoom <span class="text-slate-600">mostra mais ↔ aproxima</span></span>
                        <span id="split-video-zoom-valor" class="tabular-nums text-slate-500"><%= zoomVideo %>%</span>
                      </span>
                      <input id="split-video-zoom" type="range" min="70" max="160" step="1" value="<%= zoomVideo %>"
                        class="mt-1.5 w-full accent-emerald-500" />
                    </label>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        Empurrar ← → <span id="split-video-valor" class="tabular-nums text-slate-500"><%= offsetVideo %>%</span>
                      </span>
                      <input id="split-video-offset" type="range" min="0" max="100" step="1" value="<%= offsetVideo %>"
                        class="mt-1.5 w-full accent-emerald-500" />
                    </label>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        Empurrar ↑ ↓ <span id="split-video-valor-y" class="tabular-nums text-slate-500"><%= offsetVideoY %>%</span>
                      </span>
                      <input id="split-video-offset-y" type="range" min="0" max="100" step="1" value="<%= offsetVideoY %>"
                        class="mt-1.5 w-full accent-emerald-500" />
                    </label>
                  </div>

                  <div class="rounded-lg border border-fuchsia-500/20 bg-fuchsia-500/5 p-2.5 space-y-2.5">
                    <p class="text-[11px] font-semibold text-fuchsia-300">Imagem</p>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        <span>Zoom <span class="text-slate-600">mostra mais ↔ aproxima</span></span>
                        <span id="split-imagem-zoom-valor" class="tabular-nums text-slate-500"><%= zoomImagem %>%</span>
                      </span>
                      <input id="split-imagem-zoom" type="range" min="70" max="160" step="1" value="<%= zoomImagem %>"
                        class="mt-1.5 w-full accent-fuchsia-500" />
                    </label>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        Empurrar ← → <span id="split-imagem-valor" class="tabular-nums text-slate-500"><%= offsetImagem %>%</span>
                      </span>
                      <input id="split-imagem-offset" type="range" min="0" max="100" step="1" value="<%= offsetImagem %>"
                        class="mt-1.5 w-full accent-fuchsia-500" />
                    </label>
                    <label class="block">
                      <span class="flex items-center justify-between text-[11px] text-slate-500">
                        Empurrar ↑ ↓ <span id="split-imagem-valor-y" class="tabular-nums text-slate-500"><%= offsetImagemY %>%</span>
                      </span>
                      <input id="split-imagem-offset-y" type="range" min="0" max="100" step="1" value="<%= offsetImagemY %>"
                        class="mt-1.5 w-full accent-fuchsia-500" />
                    </label>
                  </div>
                </div>

                <div class="space-y-2 rounded-xl border border-slate-800 bg-slate-950/40 p-3">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[11px] font-medium text-slate-400">Texto no vídeo <span class="font-normal text-slate-600">(opcional)</span></p>
                    <div class="inline-flex rounded-lg border border-slate-700 bg-slate-950 p-0.5">
                      <button type="button" data-texto-pos="topo"
                        class="split-texto-pos-btn rounded-md px-2.5 py-1 text-[11px] <%= splitTextoPos === 'topo' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-400 hover:text-white' %>">
                        Topo
                      </button>
                      <button type="button" data-texto-pos="meio"
                        class="split-texto-pos-btn rounded-md px-2.5 py-1 text-[11px] <%= splitTextoPos === 'meio' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-400 hover:text-white' %>">
                        Meio
                      </button>
                      <button type="button" data-texto-pos="rodape"
                        class="split-texto-pos-btn rounded-md px-2.5 py-1 text-[11px] <%= splitTextoPos === 'rodape' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-400 hover:text-white' %>">
                        Rodapé
                      </button>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-end gap-2">
                    <label class="min-w-[7rem] flex-1">
                      <span class="text-[11px] text-slate-500">Tom da IA</span>
                      <select id="split-texto-tom"
                        class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-xs text-white focus:border-fuchsia-500 focus:outline-none">
                        <option value="natural">Natural</option>
                        <option value="polemico">Mais polêmico</option>
                        <option value="direto">Direto</option>
                        <option value="curiosidade">Curiosidade</option>
                        <option value="emocional">Emocional</option>
                        <option value="factual">Factual</option>
                      </select>
                    </label>
                    <label class="w-[7.5rem] shrink-0">
                      <span class="text-[11px] text-slate-500">Tamanho</span>
                      <select id="split-texto-ia-tamanho"
                        class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-xs text-white focus:border-fuchsia-500 focus:outline-none">
                        <option value="curto" selected>Curto</option>
                        <option value="medio">Médio</option>
                        <option value="grande">Grande</option>
                      </select>
                    </label>
                    <button type="button" id="btn-split-sugerir-texto"
                      class="rounded-lg border border-violet-500/40 bg-violet-500/15 px-3 py-1.5 text-xs font-semibold text-violet-200 hover:bg-violet-500/25">
                      Sugerir com IA
                    </button>
                  </div>

                  <textarea id="split-texto" rows="2" maxlength="280" placeholder="Ex.: SABE POR QUE O LIVRO [[SECRETO]] DE [[ENOQUE]]…"
                    class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm font-semibold uppercase leading-snug text-white placeholder:normal-case placeholder:font-normal placeholder:text-slate-600 focus:border-fuchsia-500 focus:outline-none"><%= splitTexto %></textarea>

                  <label class="block">
                    <span class="flex items-center justify-between text-[11px] font-medium text-slate-400">
                      Tamanho da fonte
                      <span class="tabular-nums text-slate-500"><span id="split-texto-tam-valor"><%= splitTextoTam %></span>%</span>
                    </span>
                    <input id="split-texto-tamanho" type="range" min="70" max="160" step="5" value="<%= splitTextoTam %>"
                      class="mt-1.5 w-full accent-fuchsia-500" />
                  </label>

                  <div class="flex flex-wrap items-end gap-2">
                    <div class="min-w-0 flex-1">
                      <p class="text-[11px] text-slate-500">Fundo do texto</p>
                      <div class="mt-1 inline-flex rounded-lg border border-slate-700 bg-slate-950 p-0.5">
                        <button type="button" data-texto-fundo="cor"
                          class="split-texto-fundo-btn rounded-md px-2.5 py-1 text-[11px] <%= splitTextoFundo === 'cor' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-400 hover:text-white' %>">
                          Com cor
                        </button>
                        <button type="button" data-texto-fundo="transparente"
                          class="split-texto-fundo-btn rounded-md px-2.5 py-1 text-[11px] <%= splitTextoFundo === 'transparente' ? 'bg-fuchsia-500 font-semibold text-white' : 'text-slate-400 hover:text-white' %>">
                          Transparente
                        </button>
                      </div>
                    </div>
                    <label id="split-texto-fundo-cor-wrap" class="<%= splitTextoFundo === 'cor' ? '' : 'hidden' %> shrink-0">
                      <span class="text-[11px] text-slate-500">Cor</span>
                      <input id="split-texto-fundo-cor" type="color" value="<%= splitTextoFundoCor %>"
                        class="mt-1 block h-8 w-12 cursor-pointer rounded border border-slate-700 bg-slate-950 p-0.5" />
                    </label>
                  </div>

                  <p class="text-[11px] text-slate-600">
                    Fica fixo no Reel <strong class="font-medium text-slate-500">depois da capa</strong> (se a capa estiver marcada).
                    Use <code class="text-fuchsia-300">[[palavra]]</code> para caixas de destaque.
                    Em fundo claro, use <strong class="font-medium text-slate-500">Com cor</strong> para o texto não sumir.
                    Estilo em <a href="/minha-marca?tab=video" class="text-fuchsia-300 hover:underline">Minha marca → vídeo</a>.
                  </p>
                </div>

                <div>
                  <div class="inline-flex flex-wrap gap-1 rounded-xl border border-slate-700 bg-slate-950 p-1" role="tablist" aria-label="Fonte da imagem">
                    <button type="button" data-split-fonte="busca" class="split-fonte-btn rounded-lg bg-fuchsia-500 px-3 py-1.5 text-xs font-semibold text-white">Buscar foto</button>
                    <button type="button" data-split-fonte="frame" class="split-fonte-btn rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white">Do vídeo</button>
                    <button type="button" data-split-fonte="upload" class="split-fonte-btn rounded-lg px-3 py-1.5 text-xs text-slate-300 hover:text-white">Upload</button>
                  </div>

                  <div id="split-pane-busca" class="mt-3">
                    <form id="split-busca-form" class="flex gap-2">
                      <input id="split-busca-termo" type="search" placeholder="Ex.: pastor no púlpito, estádio, Brasília…"
                        class="min-w-0 flex-1 rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-fuchsia-500 focus:outline-none" />
                      <button type="submit" class="shrink-0 rounded-lg bg-fuchsia-500 px-3 py-2 text-xs font-semibold text-white hover:bg-fuchsia-400">Buscar</button>
                    </form>
                    <p class="mt-1.5 text-[11px] text-slate-600">Fotos da web (Brave Images e afins). Clique em uma para usar.</p>
                    <div id="split-busca-resultados" class="mt-2 grid grid-cols-4 gap-1.5"></div>
                  </div>

                  <div id="split-pane-frame" class="mt-3 hidden">
                    <button type="button" id="btn-split-frames" class="rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-slate-200 hover:border-fuchsia-500 hover:text-white">
                      Pegar momentos do vídeo
                    </button>
                    <p class="mt-1.5 text-[11px] text-slate-600">Usa um frame do próprio corte como imagem do lado.</p>
                    <div id="split-frames-resultados" class="mt-2 grid grid-cols-4 gap-1.5"></div>
                  </div>

                  <div id="split-pane-upload" class="mt-3 hidden">
                    <input id="split-upload-file" type="file" accept=".png,.jpg,.jpeg,.webp"
                      class="w-full text-sm text-slate-300 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-700 file:px-3 file:py-2 file:text-sm file:text-slate-100 hover:file:bg-slate-600" />
                    <p class="mt-1.5 text-[11px] text-slate-600">PNG, JPG ou WebP até 12 MB.</p>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  <button type="button" id="btn-split-aplicar"
                    class="rounded-xl bg-fuchsia-500 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-fuchsia-400 disabled:opacity-50">
                    <%= splitAtivo ? 'Atualizar tela dividida' : 'Aplicar tela dividida' %>
                  </button>
                  <% if (splitAtivo) { %>
                    <button type="button" id="btn-split-enquadrar"
                      class="rounded-xl border border-slate-600 px-3 py-2.5 text-xs font-semibold text-slate-200 hover:border-fuchsia-400 hover:text-white">
                      Só reenquadrar
                    </button>
                  <% } %>
                  <span id="split-msg" class="text-[11px] text-slate-500"></span>
                </div>
              </div>
            </div>
          </section>
        </div>

        <aside class="space-y-4">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-3">
            <div class="mb-2 flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wide text-violet-300">Reel</span>
              <span class="rounded-full bg-slate-800 px-2 py-0.5 text-[10px] text-slate-400"><%= ratio %></span>
            </div>
            <% if (videoUrl) { %>
              <video id="clip-video" class="block aspect-[9/16] max-h-[420px] w-full rounded-xl border border-slate-700 bg-black object-contain" controls playsinline
                src="<%= videoUrl %>?t=<%= Date.now() %>"></video>
            <% } else { %>
              <div class="flex min-h-[240px] items-center justify-center rounded-xl border border-dashed border-slate-700 text-xs text-slate-500">Sem arquivo</div>
            <% } %>
          </div>

          <div class="rounded-2xl border border-amber-500/20 bg-slate-900/60 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-300">Música de fundo</p>
            <p class="mt-1 text-[11px] leading-relaxed text-slate-500">
              Trilhas padronizadas (baixo volume para não cobrir a fala). Troque ou remova quando quiser.
            </p>
            <label class="mt-3 block text-sm">
              <span class="text-slate-400">Estilo</span>
              <select id="clip-bgm-preset" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none">
                <% presetsLista.forEach((p) => { %>
                  <option value="<%= p.id %>" <%= bgmPreset === p.id ? 'selected' : '' %> title="<%= p.description %>"><%= p.name %></option>
                <% }) %>
              </select>
            </label>
            <p id="clip-bgm-desc" class="mt-1.5 text-[11px] text-slate-600">
              <%= (presetsLista.find((p) => p.id === bgmPreset) || {}).description || '' %>
            </p>
            <label class="mt-3 block">
              <span class="flex items-center justify-between text-[11px] font-medium text-slate-400">
                Volume da trilha
                <span class="tabular-nums text-slate-500"><span id="clip-bgm-vol-valor"><%= bgmVolume %></span>%</span>
              </span>
              <input id="clip-bgm-volume" type="range" min="5" max="40" step="1" value="<%= bgmVolume %>"
                class="mt-1.5 w-full accent-amber-500" <%= bgmPreset === 'nenhuma' ? 'disabled' : '' %> />
            </label>
            <button type="button" id="btn-bgm-aplicar"
              class="mt-3 w-full rounded-xl border border-amber-500/40 bg-amber-500/15 px-4 py-2.5 text-sm font-semibold text-amber-100 hover:bg-amber-500/25 disabled:opacity-50">
              <%= bgmPreset === 'nenhuma' ? 'Remover música' : 'Aplicar música' %>
            </button>
            <p id="clip-bgm-msg" class="mt-2 text-[11px] text-slate-500"></p>
          </div>

          <div class="rounded-2xl border border-[#1877F2]/30 bg-slate-900/60 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-[#1877F2]">Publicar</p>
            <label class="mt-3 block text-sm">
              <span class="text-slate-400">Página</span>
              <select id="clip-page" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white">
                <option value="">Carregando…</option>
              </select>
            </label>
            <label class="mt-3 block text-sm">
              <span class="text-slate-400">Formato</span>
              <select id="clip-modo" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white">
                <option value="reel" selected>Reel</option>
                <option value="video">Vídeo no feed</option>
              </select>
            </label>
            <button type="button" id="btn-publicar"
              class="mt-4 w-full rounded-xl bg-[#1877F2] px-4 py-3 text-sm font-bold text-white hover:bg-[#166FE5] disabled:opacity-50">
              Publicar no Facebook
            </button>
          </div>
        </aside>
      </div>
    <% } %>
  </main>

  <div id="publish-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 p-6 backdrop-blur-sm">
    <div class="w-full max-w-sm rounded-2xl border border-slate-700 bg-slate-900 p-8 text-center">
      <div id="publish-spin" class="mx-auto h-12 w-12 animate-spin rounded-full border-2 border-[#1877F2]/30 border-t-[#1877F2]"></div>
      <div id="publish-ok" class="mx-auto hidden h-12 w-12 items-center justify-center rounded-full bg-emerald-500/15 text-2xl text-emerald-300">✓</div>
      <h2 id="publish-title" class="mt-5 text-lg font-semibold text-white">Publicando…</h2>
      <p id="publish-text" class="mt-2 text-sm text-slate-400">Enviando o Reel para o Facebook.</p>
      <a id="publish-link" href="/fila" class="mt-4 hidden inline-block text-sm text-sky-400 hover:underline">Voltar à Produção →</a>
    </div>
  </div>

  <script>
    window.__CLIP_EDIT__ = {
      id: <%= clip.id %>,
      canEdit: <%= canEdit ? 'true' : 'false' %>,
      materiaStatus: <%- JSON.stringify(clip.materia_status || '') %>,
      capaStatus: <%- JSON.stringify(clip.capa_status || '') %>,
      splitAtivo: <%= splitAtivo ? 'true' : 'false' %>,
      splitStatus: <%- JSON.stringify(clip.split_status || '') %>,
      splitImagemUrl: <%- JSON.stringify(splitImagemUrl || '') %>,
      videoOffset: <%= offsetVideo %>,
      imagemOffset: <%= offsetImagem %>,
      videoOffsetY: <%= offsetVideoY %>,
      imagemOffsetY: <%= offsetImagemY %>,
      videoZoom: <%= zoomVideo %>,
      imagemZoom: <%= zoomImagem %>,
      splitTexto: <%- JSON.stringify(splitTexto) %>,
      splitTextoPosicao: <%- JSON.stringify(splitTextoPos) %>,
      splitTextoTamanho: <%= splitTextoTam %>,
      splitTextoFundo: <%- JSON.stringify(splitTextoFundo) %>,
      splitTextoFundoCor: <%- JSON.stringify(splitTextoFundoCor) %>,
      splitModo: <%- JSON.stringify(splitModo) %>,
      splitImagemPos: <%- JSON.stringify(splitImagemPos) %>,
      bgmPreset: <%- JSON.stringify(bgmPreset) %>,
      bgmVolume: <%= bgmVolume %>,
      bgmPresets: <%- JSON.stringify(presetsLista) %>,
    };
  </script>
  <script src="/js/fila-corte.js?v=20260731n"></script>
<%- include('partials/app-end') %>
