PORT=3000
NODE_ENV=development

DATABASE_URL=mysql://root:@localhost:3306/clipador

# Obrigatória para gerar matéria (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Modelo: deepseek-v4-flash (padrão) | deepseek-v4-pro | deepseek-chat (legado até 2026-07-24)
DEEPSEEK_MODEL=deepseek-v4-flash
PEXELS_API_KEY=

# Busca na internet para complementar matérias (recomendado: pelo menos uma)
# Sem isso, a IA só usa o texto da fonte original
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# SerpApi (https://serpapi.com) — Google Images para sugestões de capa (pessoa/assunto)
SERPAPI_API_KEY=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# PostPulse (API comercial — sem App Review da Meta)
# No painel PostPulse, Redirect URI deve ser EXATAMENTE o valor abaixo:
POSTPULSE_CLIENT_ID=
POSTPULSE_CLIENT_SECRET=
POSTPULSE_REDIRECT_URI=http://localhost:3000/api/auth/postpulse/callback

# Ayrshare — publicação Facebook (Primary Profile API Key)
# Dashboard: https://app.ayrshare.com → API Key
# Conecte a Página do Facebook em Social Accounts antes de publicar.
# Mídia precisa de URL HTTPS pública: defina APP_PUBLIC_URL (ex.: https://www.viralizeai.online)
AYRSHARE_API_KEY=
APP_PUBLIC_URL=

# PostSyncer (legado — alternativa)
# https://app.postsyncer.com → Settings → API Integration → Create
POSTSYNCER_API_KEY=
# Opcional: se vazio, usa o primeiro workspace da conta
POSTSYNCER_WORKSPACE_ID=

# auto = Ayrshare (se key) → PostSyncer (se vinculado) → PostPulse → Graph API
# ayrshare | postsyncer | postpulse | facebook
PUBLISH_PROVIDER=ayrshare

SESSION_SECRET=troque-por-um-segredo-forte

# Caminho do ffmpeg (opcional se estiver no PATH)
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe

# Autenticação yt-dlp/YouTube (não use as duas opções ao mesmo tempo)
# Desenvolvimento local: chrome, edge, firefox, brave, opera ou vivaldi
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Produção: arquivo Netscape cookies.txt fora de public/ e storage/, sempre com caminho absoluto
# YTDLP_COOKIES_FILE=/home/viralizeai/secrets/youtube-cookies.txt

# Extração de fala: Python 3.9+ + faster-whisper
# pip install -r scripts/requirements.txt
# Se `python` não estiver no PATH, aponte o executável:
# PYTHON_PATH=C:\\Python313\\python.exe
PYTHON_PATH=

# YouTube / yt-dlp (produção CloudPanel)
# YTDLP_COOKIES_FILE=/home/viralizeai/secrets/youtube-cookies.txt
# Cookies do Instagram (Netscape) — Biblioteca + gerar matéria a partir de link IG em /conteudo
# Windows local: YTDLP_IG_COOKIES_FILE=C:/caminho/do/projeto/secrets/instagram-cookies.txt
# Linux/produção: YTDLP_IG_COOKIES_FILE=/home/viralizeai/secrets/instagram-cookies.txt

# ScrapeCreators — posts Facebook/Instagram (pay-as-you-go, 100 créditos grátis no cadastro)
# Radar Face (página FB) usa isto ANTES do Apify — curtidas/comentários reais, sem limite 24h
# https://scrapecreators.com/
SCRAPECREATORS_API_KEY=

# ElevenLabs — narração humanizada para Reel (imagem da matéria + voz)
# Cadastro/teste: https://elevenlabs.io (free ~10k chars/mês) | pay-as-you-go na API
# Free: use voz de "My Voices" (não Voice Library). Sem VOICE_ID, o app escolhe uma da conta.
# My Voices: https://elevenlabs.io/app/voice-lab
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Apify — fallback Radar Face (Trends + posts FB). Free tier: ~1 run/24h por actor
# Token: https://console.apify.com/account/integrations
APIFY_TOKEN=
# Actor de busca por keyword (curtidas/comentários). Ajustável se trocar de actor.
APIFY_FB_SEARCH_ACTOR=scrapeforge/facebook-search-posts
# Opcional: Facebook location UID para filtrar geo (Brasil). Sem isso, a query inclui "Brasil".
# APIFY_FB_LOCATION_UID=
# YTDLP_JS_RUNTIME=node:/usr/local/bin/node
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Produção (CloudPanel exemplo) ---
# PORT=3010
# NODE_ENV=production
# DATABASE_URL=mysql://clipador:SENHA@127.0.0.1:3306/clipador
# FACEBOOK_REDIRECT_URI=https://www.viralizeai.online/api/auth/facebook/callback
# POSTPULSE_CLIENT_ID=
# POSTPULSE_CLIENT_SECRET=
# POSTPULSE_REDIRECT_URI=https://www.viralizeai.online/api/auth/postpulse/callback
# AYRSHARE_API_KEY=
# APP_PUBLIC_URL=https://www.viralizeai.online
# PUBLISH_PROVIDER=ayrshare
# Checklist Ayrshare: Social Accounts → conectar Página Facebook; regenerar API Key se ela vazou.
# POSTSYNCER_API_KEY=
# POSTSYNCER_WORKSPACE_ID=
# SESSION_SECRET=gere-um-segredo-longo-aleatorio
# Fuso para logs/processo (opcional; agendamento de matérias usa Araguaína UTC−3 no código)
# TZ=America/Araguaina
